{
  "name": "xpotato-site-vnext",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.19.x",
    "npm": "11.19.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "toolchain:check": "tsx packages/site-validators/src/toolchain-cli.ts",
    "schema:generate": "npm run schema:generate --workspace @xpotato/content-contracts",
    "schema:check": "npm run schema:check --workspace @xpotato/content-contracts",
    "migration:legacy:inventory": "tsx packages/site-validators/src/legacy-inventory-cli.ts --write",
    "migration:legacy:inventory:check": "tsx packages/site-validators/src/legacy-inventory-cli.ts --check",
    "migration:legacy:check": "tsx packages/site-validators/src/legacy-inventory-cli.ts --check",
    "migration:legacy:reproduce": "tsx packages/site-validators/src/legacy-reproduce-cli.ts",
    "migration:legacy:baseline:capture": "tsx packages/site-validators/src/legacy-visual-performance-cli.ts",
    "migration:legacy:baseline:check": "tsx packages/site-validators/src/legacy-visual-performance-check-cli.ts",
    "migration:content:allocate": "tsx packages/site-validators/src/phase4-content-migration-cli.ts --allocate",
    "migration:content:candidates": "tsx packages/site-validators/src/phase4-content-migration-cli.ts --write-candidates",
    "migration:content:check": "tsx packages/site-validators/src/phase4-content-migration-cli.ts --check",
    "migration:content:materialize": "tsx packages/site-validators/src/phase4-content-materialize-cli.ts --write",
    "migration:content:materialization:check": "tsx packages/site-validators/src/phase4-content-materialize-cli.ts --check",
    "migration:content:materialization:evidence:check": "tsx packages/site-validators/src/phase4-content-materialize-cli.ts --check-evidence",
    "migration:taxonomy:inventory": "tsx packages/site-validators/src/phase5-taxonomy-inventory-cli.ts --write",
    "migration:taxonomy:inventory:check": "tsx packages/site-validators/src/phase5-taxonomy-inventory-cli.ts --check",
    "migration:taxonomy:review:check": "tsx packages/site-validators/src/phase5-taxonomy-review-cli.ts --check",
    "migration:taxonomy:materialize": "tsx packages/site-validators/src/phase5-taxonomy-materialize-cli.ts --write",
    "migration:taxonomy:materialization:check": "tsx packages/site-validators/src/phase5-taxonomy-materialize-cli.ts --check",
    "migration:media:inventory": "tsx packages/site-validators/src/phase6-media-inventory-cli.ts --write",
    "migration:media:inventory:check": "tsx packages/site-validators/src/phase6-media-inventory-cli.ts --check",
    "migration:media:review:proposal": "tsx packages/site-validators/src/phase6-media-review-cli.ts --write",
    "migration:media:review:proposal:check": "tsx packages/site-validators/src/phase6-media-review-cli.ts --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "astro:check": "npm run check --workspace @xpotato/site",
    "security:generate": "tsx packages/site-validators/src/security-headers-cli.ts --write",
    "security:check": "tsx packages/site-validators/src/security-headers-cli.ts --check",
    "build:site": "npm run build --workspace @xpotato/site && npm run security:check",
    "search:build": "npm run search:build --workspace @xpotato/site",
    "validate:repository": "npm run validate --workspace @xpotato/site-validators",
    "validate:static": "npm run validate:static --workspace @xpotato/site-validators",
    "build": "npm run build:site && npm run search:build",
    "validate": "npm run toolchain:check && npm run schema:check && npm run migration:legacy:check && npm run migration:legacy:baseline:check && npm run migration:content:check && npm run migration:content:materialization:evidence:check && npm run migration:taxonomy:inventory:check && npm run migration:taxonomy:review:check && npm run migration:taxonomy:materialization:check && npm run migration:media:inventory:check && npm run migration:media:review:proposal:check && npm run test && npm run typecheck && npm run validate:repository && npm run astro:check && npm run build && npm run validate:static",
    "ci": "npm run validate"
  },
  "devDependencies": {
    "@types/node": "24.10.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
