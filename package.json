{
  "name": "xpotato-site-vnext",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "toolchain:check": "tsx packages/site-validators/src/toolchain-cli.ts",
    "schema:generate": "npm run schema:generate --workspace @xpotato/content-contracts",
    "schema:check": "npm run schema:check --workspace @xpotato/content-contracts",
    "social-card:preview": "tsx tools/authoring/blog-social-card.ts",
    "migration:legacy:inventory": "tsx tools/migration/legacy-inventory-cli.ts --write",
    "migration:legacy:inventory:check": "tsx tools/migration/legacy-inventory-cli.ts --check",
    "migration:legacy:check": "tsx tools/migration/legacy-inventory-cli.ts --check",
    "migration:legacy:reproduce": "tsx tools/migration/legacy-reproduce-cli.ts",
    "migration:legacy:baseline:capture": "tsx tools/migration/legacy-visual-performance-cli.ts",
    "migration:legacy:baseline:check": "tsx tools/migration/legacy-visual-performance-check-cli.ts",
    "migration:content:allocate": "tsx tools/migration/phase4-content-migration-cli.ts --allocate",
    "migration:content:candidates": "tsx tools/migration/phase4-content-migration-cli.ts --write-candidates",
    "migration:content:check": "tsx tools/migration/phase4-content-migration-cli.ts --check",
    "migration:content:materialize": "tsx tools/migration/phase4-content-materialize-cli.ts --write",
    "migration:content:materialization:check": "tsx tools/migration/phase4-content-materialize-cli.ts --check",
    "migration:content:materialization:evidence:check": "tsx tools/migration/phase4-content-materialize-cli.ts --check-evidence",
    "migration:taxonomy:inventory": "tsx tools/migration/phase5-taxonomy-inventory-cli.ts --write",
    "migration:taxonomy:inventory:check": "tsx tools/migration/phase5-taxonomy-inventory-cli.ts --check",
    "migration:taxonomy:review:check": "tsx tools/migration/phase5-taxonomy-review-cli.ts --check",
    "migration:taxonomy:materialize": "tsx tools/migration/phase5-taxonomy-materialize-cli.ts --write",
    "migration:taxonomy:materialization:check": "tsx tools/migration/phase5-taxonomy-materialize-cli.ts --check",
    "migration:media:inventory": "tsx tools/migration/phase6-media-inventory-cli.ts --write",
    "migration:media:inventory:check": "tsx tools/migration/phase6-media-inventory-cli.ts --check",
    "migration:media:review:proposal": "tsx tools/migration/phase6-media-review-cli.ts --write",
    "migration:media:review:proposal:check": "tsx tools/migration/phase6-media-review-cli.ts --check",
    "migration:media:candidate": "tsx tools/migration/phase6-media-candidate-cli.ts --write",
    "migration:media:candidate:emit": "tsx tools/migration/phase6-media-candidate-cli.ts --write --emit-sources",
    "migration:media:candidate:check": "tsx tools/migration/phase6-media-candidate-cli.ts --check",
    "migration:media:processing": "tsx tools/migration/phase6-media-processing-cli.ts --write",
    "migration:media:processing:check": "tsx tools/migration/phase6-media-processing-cli.ts --check",
    "migration:interactive:write": "tsx tools/migration/phase7-interactive-readiness-cli.ts --write",
    "migration:interactive:check": "tsx tools/migration/phase7-interactive-readiness-cli.ts --check",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tools/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:phase7": "vitest run apps/site/src/components/islands/prime-factorizer.test.ts apps/site/src/content-registry/interactive/resolve.test.ts packages/content-contracts/src/contracts.test.ts packages/site-validators/src/registry-invariants.test.ts",
    "astro:check": "npm run check --workspace @xpotato/site",
    "security:generate": "npm run publication:generate",
    "security:check": "npm run publication:check",
    "build:site": "npm run build --workspace @xpotato/site",
    "search:build": "npm run search:build --workspace @xpotato/site",
    "validate:repository": "npm run validate --workspace @xpotato/site-validators",
    "validate:static": "npm run validate:static --workspace @xpotato/site-validators",
    "phase7:check": "npm run migration:interactive:check",
    "build": "npm run build:site && npm run search:build && npm run publication:generate",
    "validate": "npm run ci",
    "ci": "npm run ci:source && npm run build && npm run ci:final",
    "test:phase8": "vitest run apps/site/src/lib apps/site/src/search packages/site-validators/src/migration/phase8-route-discovery-readiness.test.ts packages/site-validators/src/migration/phase8-search-evidence.test.ts",
    "phase8:preview": "tsx tools/migration/phase8-preview-cli.ts",
    "phase8:write": "tsx tools/migration/phase8-route-discovery-readiness-cli.ts --capture-write",
    "phase8:capture:check": "tsx tools/migration/phase8-route-discovery-readiness-cli.ts --capture-check",
    "phase8:held-preview:check": "tsx tools/migration/phase8-route-discovery-readiness-cli.ts --held-preview-check",
    "phase8:evidence:check": "tsx tools/migration/phase8-route-discovery-readiness-cli.ts --check",
    "phase8:serving:check": "tsx tools/migration/phase8-serving-cli.ts",
    "phase8:check": "npm run phase8:evidence:check",
    "ci:source": "npm run browser-tools:install -- check && npm run toolchain:check && npm run schema:check && npm run migration:legacy:check && npm run migration:legacy:baseline:check && npm run migration:content:check && npm run migration:content:materialization:evidence:check && npm run migration:taxonomy:inventory:check && npm run migration:taxonomy:review:check && npm run migration:taxonomy:materialization:check && npm run migration:media:inventory:check && npm run migration:media:review:proposal:check && npm run migration:media:candidate:check && npm run test && npm run test:release && npm run typecheck && npm run validate:repository && npm run astro:check && npm run authoring:isolation:prepare && npm run review:isolation:prepare && npm run visual:isolation:prepare && npm run publication:isolation:prepare",
    "ci:final": "npm run publication:check && npm run publication:isolation:check && npm run visual:isolation:check && npm run review:isolation:check && npm run authoring:isolation:check && npm run validate:static && npm run performance:check && npm run migration:interactive:check && npm run phase8:evidence:check && npm run release:interaction",
    "performance:check": "tsx tools/qa/performance-budget.mjs",
    "performance:measure": "node tools/qa/performance-smoke.mjs",
    "test:release": "node --test scripts/ci-scope.test.mjs scripts/release-graph.test.mjs tools/qa/lighthouse-collect.test.mjs tools/qa/parallel-browser-suites.test.mjs scripts/release/deployment/manual-deployment.test.mjs scripts/release/deployment/publication-plan.test.mjs",
    "release:package": "tsx tools/build/release-package-cli.ts",
    "release:produce": "npm run ci && npm run release:package",
    "home:check": "node tools/qa/project-carousel-smoke.mjs",
    "release:interaction": "node tools/qa/release-interaction.mjs",
    "quality:lighthouse": "node tools/qa/lighthouse-report.mjs",
    "external-links:report": "tsx packages/site-validators/src/delivery/external-links-cli.ts",
    "site": "tsx tools/authoring/site.ts",
    "authoring:isolation:prepare": "tsx tools/qa/authoring-isolation.ts --prepare",
    "authoring:isolation:check": "tsx tools/qa/authoring-isolation.ts --check",
    "browser-tools:fixture": "tsx tools/qa/browser-tool-fixture.ts",
    "browser-tools": "tsx tools/authoring/browser-tool.ts",
    "review:isolation:prepare": "tsx tools/qa/article-review-isolation.ts --prepare",
    "review:isolation:check": "tsx tools/qa/article-review-isolation.ts --check",
    "visual:isolation:prepare": "tsx tools/qa/article-visual-isolation.ts --prepare",
    "visual:isolation:check": "tsx tools/qa/article-visual-isolation.ts --check",
    "publication:isolation:prepare": "tsx tools/qa/article-publication-isolation.ts --prepare",
    "publication:isolation:check": "tsx tools/qa/article-publication-isolation.ts --check",
    "browser-tools:author": "tsx tools/authoring/browser-tool-authoring.ts",
    "browser-tools:install": "tsx tools/authoring/browser-tool-install.ts",
    "article:publication:preflight": "tsx tools/review/articles/article-publication-preflight.ts",
    "article:research:check": "tsx tools/review/articles/article-research-check.ts",
    "publication:generate": "tsx tools/build/publication.ts",
    "publication:check": "tsx tools/build/publication.ts --check",
    "content": "tsx tools/authoring/content.ts",
    "content:smoke": "node tools/qa/content-workflows-smoke.mjs",
    "tools:smoke": "tsx tools/qa/common-tool-fixture.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.10",
    "axe-core": "4.14.0",
    "hast-util-from-html": "2.0.3",
    "katex": "0.19.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.3",
    "lighthouse": "13.5.0",
    "chrome-launcher": "1.2.2"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "6.2.1"
    }
  }
}
