{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "toolId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "integration": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "react-island"
        },
        "apiVersion": {
          "type": "number",
          "const": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
        },
        "styles": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          }
        }
      },
      "required": [
        "kind",
        "apiVersion",
        "entry",
        "styles"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "network": {
              "type": "string",
              "const": "none-after-ready"
            },
            "storage": {
              "type": "string",
              "const": "memory"
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "fileInput": {
                  "type": "boolean",
                  "const": false
                },
                "download": {
                  "type": "boolean",
                  "const": false
                },
                "clipboard": {
                  "type": "boolean",
                  "const": false
                },
                "worker": {
                  "type": "boolean",
                  "const": false
                },
                "wasm": {
                  "type": "boolean",
                  "const": false
                }
              },
              "required": [
                "fileInput",
                "download",
                "clipboard",
                "worker",
                "wasm"
              ],
              "additionalProperties": false
            },
            "maxInputBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65536
            },
            "maxOutputBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 262144
            },
            "maxComputeMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "network",
            "storage",
            "capabilities",
            "maxInputBytes",
            "maxOutputBytes",
            "maxComputeMs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "prime-factorizer-async-v1"
            },
            "network": {
              "type": "string",
              "const": "none-after-ready"
            },
            "storage": {
              "type": "string",
              "const": "memory"
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "fileInput": {
                  "type": "boolean",
                  "const": false
                },
                "download": {
                  "type": "boolean",
                  "const": false
                },
                "clipboard": {
                  "type": "boolean",
                  "const": false
                },
                "worker": {
                  "type": "boolean",
                  "const": true
                },
                "wasm": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "fileInput",
                "download",
                "clipboard",
                "worker",
                "wasm"
              ],
              "additionalProperties": false
            },
            "maxInputBytes": {
              "type": "number",
              "const": 16384
            },
            "maxOutputBytes": {
              "type": "number",
              "const": 262144
            },
            "maxComputeMs": {
              "type": "number",
              "const": 100
            },
            "jobMaxMs": {
              "type": "number",
              "const": 3600000
            },
            "maxWorkers": {
              "type": "number",
              "const": 6
            },
            "maxWasmBytes": {
              "type": "number",
              "const": 1610612736
            },
            "maxTransportBytes": {
              "type": "number",
              "const": 67108864
            }
          },
          "required": [
            "profile",
            "network",
            "storage",
            "capabilities",
            "maxInputBytes",
            "maxOutputBytes",
            "maxComputeMs",
            "jobMaxMs",
            "maxWorkers",
            "maxWasmBytes",
            "maxTransportBytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "bounded-browser-v2"
            },
            "network": {
              "type": "string",
              "const": "none-after-ready"
            },
            "storage": {
              "type": "string",
              "const": "memory"
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "fileInput": {
                  "type": "boolean",
                  "const": false
                },
                "download": {
                  "type": "boolean",
                  "const": false
                },
                "clipboard": {
                  "type": "boolean"
                },
                "worker": {
                  "type": "boolean"
                },
                "wasm": {
                  "type": "boolean"
                }
              },
              "required": [
                "fileInput",
                "download",
                "clipboard",
                "worker",
                "wasm"
              ],
              "additionalProperties": false
            },
            "clipboardPolicy": {
              "type": "string",
              "const": "user-gesture-write-only"
            },
            "assetMode": {
              "type": "string",
              "const": "fixed-bundled"
            },
            "maxInputBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65536
            },
            "maxOutputBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 262144
            },
            "maxComputeMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "jobMaxMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 3600000
            },
            "maxWorkers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "maxWasmBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1610612736
            },
            "maxTransportBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 67108864
            },
            "embeddedWorkerModules": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
              }
            },
            "embeddedWasmModules": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
              }
            },
            "workerLoaderModules": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
              }
            }
          },
          "required": [
            "profile",
            "network",
            "storage",
            "capabilities",
            "clipboardPolicy",
            "assetMode",
            "maxInputBytes",
            "maxOutputBytes",
            "maxComputeMs",
            "jobMaxMs",
            "maxWorkers",
            "maxWasmBytes",
            "maxTransportBytes",
            "embeddedWorkerModules",
            "embeddedWasmModules",
            "workerLoaderModules"
          ],
          "additionalProperties": false
        }
      ]
    },
    "uiCapabilities": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "integer-factorization"
        },
        "input": {
          "type": "object",
          "properties": {
            "maxTextLength": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65536
            },
            "minimum": {
              "type": "string",
              "const": "0"
            },
            "scientificNotation": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "maxTextLength",
            "minimum",
            "scientificNotation"
          ],
          "additionalProperties": false
        },
        "defaultMode": {
          "type": "string",
          "enum": [
            "standard",
            "optimized",
            "wide"
          ]
        },
        "completionGuaranteed": {
          "type": "boolean",
          "const": false
        },
        "smallInputRoute": {
          "type": "object",
          "properties": {
            "modeId": {
              "type": "string",
              "enum": [
                "standard",
                "optimized",
                "wide"
              ]
            },
            "exclusiveUpperPowerOfTwo": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 40000
            },
            "timeBudgetMaxMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 3600000
            }
          },
          "required": [
            "modeId",
            "exclusiveUpperPowerOfTwo",
            "timeBudgetMaxMs"
          ],
          "additionalProperties": false
        },
        "modes": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "standard",
                  "optimized",
                  "wide"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "uiLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "maxDigits": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "maxBits": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 40000
              },
              "experimentalAboveBits": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 40000
              },
              "timeBudgetMaxMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600000
              }
            },
            "required": [
              "id",
              "label",
              "uiLabel",
              "maxDigits",
              "maxBits",
              "timeBudgetMaxMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "input",
        "defaultMode",
        "completionGuaranteed",
        "modes"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx": {
          "type": "string",
          "enum": [
            "MIT",
            "Apache-2.0",
            "BSD-2-Clause",
            "BSD-3-Clause",
            "ISC",
            "AGPL-3.0-only"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
        },
        "notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
        },
        "additional": {
          "minItems": 1,
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          }
        }
      },
      "required": [
        "spdx",
        "file",
        "notice"
      ],
      "additionalProperties": false
    },
    "files": {
      "minItems": 4,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "toolId",
    "version",
    "integration",
    "runtime",
    "license",
    "files"
  ],
  "additionalProperties": false
}
