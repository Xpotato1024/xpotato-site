{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "toolId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^@xpotato-tool\\/[a-z][a-z0-9-]*$"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "github"
            },
            "repository": {
              "type": "string",
              "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
            }
          },
          "required": [
            "kind",
            "repository"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local-fixture"
            },
            "name": {
              "type": "string",
              "const": "synthetic-browser-tool"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "toolId",
    "releaseId",
    "packageName",
    "source",
    "sourceCommit",
    "sourceTreeSha256",
    "lockSha256",
    "manifestSha256",
    "artifactSha256",
    "reviewSha256"
  ],
  "additionalProperties": false
}
