{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "role": {
      "type": "string",
      "const": "primary_tool"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ]
    }
  },
  "required": [
    "contentId",
    "moduleId",
    "role",
    "status"
  ],
  "additionalProperties": false
}
