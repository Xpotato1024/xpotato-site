{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "usage": {
      "type": "string",
      "enum": [
        "inline",
        "hero",
        "gallery",
        "overview",
        "social"
      ]
    },
    "widths": {
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp",
              "avif"
            ]
          },
          "qualityProfileId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "lossless": {
            "type": "boolean"
          }
        },
        "required": [
          "format"
        ],
        "additionalProperties": false
      }
    },
    "preserveOriginalWhenSmaller": {
      "type": "boolean"
    },
    "upscale": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "usage",
    "widths",
    "formats",
    "preserveOriginalWhenSmaller",
    "upscale"
  ],
  "additionalProperties": false
}
