{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "materializationVersion": {
      "type": "string",
      "const": "legacy-taxonomy-materialization-v1"
    },
    "phase4MaterializationManifestPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rawInventoryManifestPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taxonomyRegistryPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "legacyContentId": {
            "type": "string",
            "pattern": "^(?:blog|notes|projects|tools|pages):[^:\\0]+(?:\\/[^:\\0]+)*$"
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          },
          "phase4TargetFileSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "finalTargetFileSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "finalFrontmatterSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "categoryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "subjectId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "toolCategoryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "stackIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "retiredRawTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "appliedRawTermCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "recordPayloadSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "legacyContentId",
          "targetPath",
          "phase4TargetFileSha256",
          "finalTargetFileSha256",
          "finalFrontmatterSha256",
          "tagIds",
          "stackIds",
          "retiredRawTerms",
          "appliedRawTermCount",
          "recordPayloadSha256"
        ],
        "additionalProperties": false
      }
    },
    "manifestPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "materializationVersion",
    "phase4MaterializationManifestPayloadSha256",
    "rawInventoryManifestPayloadSha256",
    "reviewPayloadSha256",
    "taxonomyRegistryPayloadSha256",
    "records",
    "manifestPayloadSha256"
  ],
  "additionalProperties": false
}
