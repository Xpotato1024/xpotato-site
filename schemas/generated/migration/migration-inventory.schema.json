{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "hashRuleVersion": {
      "type": "string",
      "const": "legacy-source-bytes-v1"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "generatorVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "commitSha",
        "generatedAt",
        "generatorVersion"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "enum": [
              "blog",
              "notes",
              "projects",
              "tools",
              "pages"
            ]
          },
          "legacyPath": {
            "type": "string",
            "minLength": 1
          },
          "legacyContentId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "draft": {
            "type": "boolean"
          },
          "bodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frontmatterSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "referencedMediaPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "referencedInteractiveComponents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "collection",
          "legacyPath",
          "legacyContentId",
          "title",
          "draft",
          "bodySha256",
          "frontmatterSha256",
          "referencedMediaPaths",
          "referencedInteractiveComponents"
        ],
        "additionalProperties": false
      }
    },
    "contentMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "legacyContentId": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "migrate",
              "merge",
              "retire"
            ]
          },
          "vNextContentId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "legacyContentId",
          "disposition"
        ],
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "urlPath": {
            "type": "string",
            "pattern": "^\\/.*"
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "content",
              "static_page",
              "redirect",
              "generated_archive",
              "tool"
            ]
          },
          "statusCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "urlPath",
          "sourceKind"
        ],
        "additionalProperties": false
      }
    },
    "routeParity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "legacyPath": {
            "type": "string",
            "pattern": "^\\/.*"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "same",
              "redirect",
              "retired",
              "provider_redirect"
            ]
          },
          "vNextPath": {
            "type": "string",
            "pattern": "^\\/.*"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "legacyPath",
          "disposition"
        ],
        "additionalProperties": false
      }
    },
    "media": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "verificationStatus": {
                "type": "string",
                "const": "git_verified"
              },
              "legacyPath": {
                "type": "string",
                "minLength": 1
              },
              "sourceFileSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "detectedFormat": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "referencedByContentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "likelyOrigin": {
                "type": "string",
                "enum": [
                  "wordpress",
                  "project",
                  "tool",
                  "site_asset",
                  "unknown"
                ]
              }
            },
            "required": [
              "verificationStatus",
              "legacyPath",
              "sourceFileSha256",
              "sizeBytes",
              "detectedFormat",
              "referencedByContentIds",
              "likelyOrigin"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "verificationStatus": {
                "type": "string",
                "const": "unresolved_non_local"
              },
              "legacyPath": {
                "type": "string",
                "minLength": 1
              },
              "referencedByContentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:blog|notes|projects|tools|pages):[^:\\0]+(?:\\/[^:\\0]+)*$"
                }
              },
              "likelyOrigin": {
                "type": "string",
                "enum": [
                  "wordpress",
                  "project",
                  "tool",
                  "site_asset",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "non_git_locator",
                  "missing_git_object"
                ]
              }
            },
            "required": [
              "verificationStatus",
              "legacyPath",
              "referencedByContentIds",
              "likelyOrigin",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "mediaMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "legacyPath": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "r2_content_media",
              "git_site_asset",
              "regenerated",
              "retired"
            ]
          },
          "contentBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "contentId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "semanticAssetId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "contentId",
                "semanticAssetId",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "publicObjectSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "publicObjectKey": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "legacyPath",
          "disposition"
        ],
        "additionalProperties": false
      }
    },
    "taxonomy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "rawValue": {
            "type": "string",
            "minLength": 1
          },
          "normalizedValue": {
            "type": "string",
            "minLength": 1
          },
          "usageCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:blog|notes|projects|tools|pages):[^:\\0]+(?:\\/[^:\\0]+)*$"
            }
          }
        },
        "required": [
          "namespace",
          "rawValue",
          "normalizedValue",
          "usageCount",
          "contentIds"
        ],
        "additionalProperties": false
      }
    },
    "interactive": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "componentPath": {
            "type": "string",
            "minLength": 1
          },
          "usedByContentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:blog|notes|projects|tools|pages):[^:\\0]+(?:\\/[^:\\0]+)*$"
            }
          },
          "framework": {
            "type": "string",
            "minLength": 1
          },
          "hydrationDirective": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "registry_module",
              "rewrite",
              "retire"
            ]
          },
          "vNextModuleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "componentPath",
          "usedByContentIds",
          "framework"
        ],
        "additionalProperties": false
      }
    },
    "legacyHtml": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "contentId": {
                "type": "string",
                "pattern": "^(?:blog|notes|projects|tools|pages):[^:\\0]+(?:\\/[^:\\0]+)*$"
              },
              "extractionStatus": {
                "type": "string",
                "const": "static"
              },
              "rawHtmlSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "convert_mdx",
                  "manual_review",
                  "retire"
                ]
              }
            },
            "required": [
              "contentId",
              "extractionStatus",
              "rawHtmlSha256",
              "disposition"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "contentId": {
                "type": "string",
                "pattern": "^(?:blog|notes|projects|tools|pages):[^:\\0]+(?:\\/[^:\\0]+)*$"
              },
              "extractionStatus": {
                "type": "string",
                "const": "blocked"
              },
              "blocker": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "type": "string",
                "const": "manual_review"
              }
            },
            "required": [
              "contentId",
              "extractionStatus",
              "blocker",
              "disposition"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "inventoryPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "hashRuleVersion",
    "snapshot",
    "content",
    "contentMappings",
    "routes",
    "routeParity",
    "media",
    "mediaMappings",
    "taxonomy",
    "interactive",
    "legacyHtml",
    "inventoryPayloadSha256"
  ],
  "additionalProperties": false
}
