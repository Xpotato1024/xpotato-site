{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "jobFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "source_discovery",
        "evidence",
        "author",
        "content_audit",
        "revision",
        "visual_plan",
        "visual_audit"
      ]
    },
    "inputArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "artifactId",
          "sha256",
          "mediaType",
          "sizeBytes"
        ],
        "additionalProperties": false
      }
    },
    "skill": {
      "type": "object",
      "properties": {
        "skillId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "skillSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "referenceBundleSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "skillId",
        "skillSha256",
        "referenceBundleSha256"
      ],
      "additionalProperties": false
    },
    "responseSchema": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "schemaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaId",
        "schemaSha256"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "maxOutputBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "publicSafetyRequired": {
          "type": "boolean"
        },
        "externalFactPolicy": {
          "type": "string",
          "enum": [
            "discover_candidates_only",
            "fixed_sources_only"
          ]
        }
      },
      "required": [
        "maxOutputBytes",
        "publicSafetyRequired",
        "externalFactPolicy"
      ],
      "additionalProperties": false
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "external",
        "local"
      ]
    },
    "externalAiDisclosureManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "jobId",
    "jobFingerprint",
    "stage",
    "inputArtifacts",
    "skill",
    "responseSchema",
    "constraints",
    "executionMode",
    "requestSha256"
  ],
  "additionalProperties": false
}
