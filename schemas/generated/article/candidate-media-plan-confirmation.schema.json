{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "human_local",
        "synthetic_fixture",
        "existing_ai"
      ]
    },
    "profileId": {
      "type": "string",
      "const": "article-media-targets-v1"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "human"
        },
        "principalId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "confirmedProfileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "purpose": {
          "type": "string",
          "const": "candidate_planning_only"
        }
      },
      "required": [
        "kind",
        "principalId",
        "confirmedProfileSha256",
        "confirmedAt",
        "purpose"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "profileId",
    "profileSha256",
    "confirmation"
  ],
  "additionalProperties": false
}
