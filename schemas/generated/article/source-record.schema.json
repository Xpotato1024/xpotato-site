{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "official_doc",
        "standard",
        "paper",
        "web_page",
        "github_file",
        "github_commit",
        "github_release",
        "repository_doc",
        "user_note",
        "user_log",
        "local_image",
        "local_file"
      ]
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "web"
            },
            "canonicalUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "kind",
            "canonicalUrl"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "github"
            },
            "repository": {
              "type": "string",
              "pattern": "^[^/\\s]+\\/[^/\\s]+$"
            },
            "commitSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "blobSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "repository",
            "commitSha"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "doi"
            },
            "doi": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "doi"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "repository"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "commitSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "blobSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "path",
            "commitSha",
            "blobSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "artifactSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "publicDescription": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "artifactSha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "snapshotSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "trustClass": {
      "type": "string",
      "enum": [
        "primary",
        "authoritative_secondary",
        "secondary",
        "user_supplied"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "stable",
        "time_sensitive"
      ]
    },
    "publicSafe": {
      "type": "boolean"
    },
    "citation": {
      "type": "object",
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        },
        "publishedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "eligible"
      ],
      "additionalProperties": false
    },
    "externalAiDisclosureRef": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "sourceId",
    "kind",
    "locator",
    "trustClass",
    "freshness",
    "publicSafe",
    "citation",
    "externalAiDisclosureRef"
  ],
  "additionalProperties": false
}
