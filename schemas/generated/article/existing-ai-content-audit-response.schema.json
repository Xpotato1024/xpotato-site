{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "xpotato-private-existing-ai-content-audit-response-v1"
    },
    "independentlyExtractedClaims": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "span": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "text",
          "span",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "coveredClaimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "materialCoverage": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "severity",
          "message",
          "claimIds"
        ],
        "additionalProperties": false
      }
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "pass",
        "revision_required",
        "blocked"
      ]
    },
    "limitations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "protocol",
    "independentlyExtractedClaims",
    "coveredClaimIds",
    "materialCoverage",
    "findings",
    "conclusion",
    "limitations"
  ],
  "additionalProperties": false
}
