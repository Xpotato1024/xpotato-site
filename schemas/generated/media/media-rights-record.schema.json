{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "rightsId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "basis": {
      "type": "string",
      "enum": [
        "self_created",
        "ai_generated_authorized",
        "licensed",
        "public_domain",
        "permission_granted",
        "limited_excerpt",
        "unknown"
      ]
    },
    "publicationAuthorized": {
      "type": "boolean"
    },
    "ownerOrSource": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "licenseId": {
      "type": "string",
      "minLength": 1
    },
    "licenseUrl": {
      "type": "string",
      "format": "uri"
    },
    "attributionText": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "commercialUse": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "modification": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "redistribution": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "confirmedBy": {
      "type": "string",
      "enum": [
        "system_policy",
        "user",
        "migration_review"
      ]
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "rightsId",
    "basis",
    "publicationAuthorized",
    "confirmedBy",
    "confirmedAt"
  ],
  "additionalProperties": false
}
