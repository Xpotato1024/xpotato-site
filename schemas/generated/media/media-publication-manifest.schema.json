{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "article_job"
            },
            "jobId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "candidateSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "humanApprovalRecordSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "canonicalSourceStorageReceiptSetSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "articleJobPublicMediaPermission": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "kind",
            "jobId",
            "candidateSha256",
            "humanApprovalRecordSha256",
            "canonicalSourceStorageReceiptSetSha256",
            "articleJobPublicMediaPermission"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "migration"
            },
            "migrationPlanSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "operatorAuthorizationRecordSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "canonicalSourceStorageReceiptSetSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "migrationPlanSha256",
            "operatorAuthorizationRecordSha256",
            "canonicalSourceStorageReceiptSetSha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mediaSets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "rightsRef": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "variantManifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "purpose": {
                  "type": "string",
                  "enum": [
                    "master",
                    "variant"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "objectKey": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "jpeg",
                    "png",
                    "webp",
                    "avif",
                    "svg"
                  ]
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "contentType": {
                  "type": "string",
                  "minLength": 1
                },
                "cacheControl": {
                  "type": "string",
                  "const": "public, max-age=31536000, immutable"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "uploaded",
                    "reused"
                  ]
                },
                "verifiedSizeBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "verifiedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "purpose",
                "sha256",
                "objectKey",
                "format",
                "contentType",
                "cacheControl",
                "action",
                "verifiedSizeBytes",
                "verifiedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "assetId",
          "rightsRef",
          "variantManifestSha256",
          "objects"
        ],
        "additionalProperties": false
      }
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "authorization",
    "mediaSets",
    "completedAt",
    "manifestSha256"
  ],
  "additionalProperties": false
}
