{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "properties": {
        "contentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "semanticAssetId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "contentId",
        "semanticAssetId"
      ],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": [
        "photo",
        "screenshot",
        "diagram"
      ]
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "overwrite": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "sourcePath",
    "target",
    "kind",
    "profileId",
    "overwrite"
  ],
  "additionalProperties": false
}
