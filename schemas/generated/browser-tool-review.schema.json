{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "github"
            },
            "repository": {
              "type": "string",
              "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
            }
          },
          "required": [
            "kind",
            "repository"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local-fixture"
            },
            "name": {
              "type": "string",
              "const": "synthetic-browser-tool"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reproducibleArtifactSha256": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "fixture-only",
            "source-and-release"
          ]
        },
        "decision": {
          "type": "string",
          "const": "admit"
        }
      },
      "required": [
        "reviewer",
        "scope",
        "decision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "sourceCommit",
    "sourceTreeSha256",
    "lockSha256",
    "manifestSha256",
    "artifactSha256",
    "reproducibleArtifactSha256",
    "review"
  ],
  "additionalProperties": false
}
