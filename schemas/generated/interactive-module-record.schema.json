{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "framework": {
      "type": "string",
      "const": "react"
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "hydration": {
      "type": "string",
      "enum": [
        "load",
        "idle",
        "visible",
        "media"
      ]
    },
    "mediaQuery": {
      "type": "string",
      "minLength": 1
    },
    "allowedCollections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "blog",
          "notes",
          "projects",
          "tools",
          "pages"
        ]
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "primary_tool",
        "inline_demo"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ]
    },
    "apiVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "budgetClass": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ]
    }
  },
  "required": [
    "id",
    "framework",
    "componentId",
    "hydration",
    "allowedCollections",
    "role",
    "status",
    "apiVersion",
    "budgetClass"
  ],
  "additionalProperties": false
}
