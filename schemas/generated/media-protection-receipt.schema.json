{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "candidateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalRecordSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mediaPublicationManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protectionClass": {
      "type": "string",
      "const": "cloudflare_protected_copy_v1"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceObjectKey": {
            "type": "string",
            "minLength": 1
          },
          "verifiedSizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "protectedObjectRef": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "protectedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "sha256",
          "sourceObjectKey",
          "verifiedSizeBytes",
          "protectedObjectRef",
          "protectedAt"
        ],
        "additionalProperties": false
      }
    },
    "policyFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "candidateSha256",
    "approvalRecordSha256",
    "mediaPublicationManifestSha256",
    "protectionClass",
    "objects",
    "policyFingerprint",
    "completedAt",
    "receiptSha256"
  ],
  "additionalProperties": false
}
