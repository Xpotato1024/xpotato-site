{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keyId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "principalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "human_local",
        "synthetic_fixture"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ]
    },
    "publicKeySpkiDerBase64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "publicKeySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "bindings": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "profileSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "implementationSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "toolchainSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "runtimeVersion": {
            "type": "string",
            "minLength": 1
          },
          "verifierVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "profileId",
          "profileSha256",
          "implementationSha256",
          "toolchainSha256",
          "runtimeVersion",
          "verifierVersion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "keyId",
    "principalId",
    "scope",
    "status",
    "publicKeySpkiDerBase64",
    "publicKeySha256",
    "validFrom",
    "bindings"
  ],
  "additionalProperties": false
}
