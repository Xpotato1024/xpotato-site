{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "human_local",
        "synthetic_fixture"
      ]
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "human"
        },
        "principalId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "kind",
        "principalId"
      ],
      "additionalProperties": false
    },
    "independence": {
      "type": "object",
      "properties": {
        "separateReview": {
          "type": "boolean",
          "const": true
        },
        "authorIdentityConfirmed": {
          "type": "boolean",
          "const": true
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "separateReview",
        "authorIdentityConfirmed",
        "basis"
      ],
      "additionalProperties": false
    },
    "coveredClaimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "materialCoverage": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "severity",
          "message",
          "claimIds"
        ],
        "additionalProperties": false
      }
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "pass",
        "revision_required",
        "blocked"
      ]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "requestSha256",
    "reviewer",
    "independence",
    "coveredClaimIds",
    "materialCoverage",
    "findings",
    "conclusion",
    "reviewedAt"
  ],
  "additionalProperties": false
}
