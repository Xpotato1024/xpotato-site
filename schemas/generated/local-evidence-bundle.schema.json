{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "bodySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceBundleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "sourceRecordSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "sourceId",
                "sourceRecordSha256"
              ],
              "additionalProperties": false
            }
          },
          "interpretation": {
            "type": "string",
            "enum": [
              "explicit",
              "direct_observation",
              "reasonable_inference",
              "user_experience",
              "recommendation_basis",
              "unknown"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "not_available"
            ]
          },
          "freshnessChecked": {
            "type": "boolean"
          },
          "ambiguityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "evidenceId",
          "proposition",
          "sourceRefs",
          "interpretation",
          "confidence",
          "freshnessChecked",
          "ambiguityIds"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "draftSpan": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claimType": {
            "type": "string",
            "enum": [
              "source_fact",
              "user_experience",
              "inference",
              "recommendation",
              "transition",
              "limitation"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "claimId",
          "draftSpan",
          "text",
          "claimType",
          "evidenceIds",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "ambiguities": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ambiguityId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "candidateInterpretations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution": {
            "type": "string",
            "enum": [
              "unresolved",
              "resolved",
              "not_required"
            ]
          },
          "resolvedByEvidenceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "ambiguityId",
          "subject",
          "reason",
          "candidateInterpretations",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "extracts": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "textSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "evidenceId",
          "sourceId",
          "start",
          "end",
          "textSha256"
        ],
        "additionalProperties": false
      }
    },
    "examples": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exampleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "requestedVerification": {
            "type": "string",
            "enum": [
              "illustrative",
              "syntax_checked",
              "sandbox_executed",
              "evidence_observed",
              "not_verifiable"
            ]
          },
          "intendedPurpose": {
            "type": "string",
            "minLength": 1
          },
          "verificationRequired": {
            "type": "boolean"
          },
          "materialClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "exampleId",
          "requestedVerification",
          "intendedPurpose",
          "verificationRequired",
          "materialClaimIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "bodySha256",
    "sourceBundleSha256",
    "evidence",
    "claims",
    "ambiguities",
    "extracts",
    "examples"
  ],
  "additionalProperties": false
}
