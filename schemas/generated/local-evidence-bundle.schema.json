{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "bodySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceBundleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "sourceRecordSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "sourceId",
                "sourceRecordSha256"
              ],
              "additionalProperties": false
            }
          },
          "interpretation": {
            "type": "string",
            "enum": [
              "explicit",
              "direct_observation",
              "reasonable_inference",
              "user_experience",
              "recommendation_basis",
              "unknown"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "not_available"
            ]
          },
          "freshnessChecked": {
            "type": "boolean"
          },
          "ambiguityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "evidenceId",
          "proposition",
          "sourceRefs",
          "interpretation",
          "confidence",
          "freshnessChecked",
          "ambiguityIds"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "draftSpan": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claimType": {
            "type": "string",
            "enum": [
              "source_fact",
              "user_experience",
              "inference",
              "recommendation",
              "transition",
              "limitation"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "claimId",
          "draftSpan",
          "text",
          "claimType",
          "evidenceIds",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "ambiguities": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ambiguityId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "candidateInterpretations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution": {
            "type": "string",
            "enum": [
              "unresolved",
              "resolved",
              "not_required"
            ]
          },
          "resolvedByEvidenceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "ambiguityId",
          "subject",
          "reason",
          "candidateInterpretations",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "extracts": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "textSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "evidenceId",
          "sourceId",
          "start",
          "end",
          "textSha256"
        ],
        "additionalProperties": false
      }
    },
    "examples": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exampleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "requestedVerification": {
            "type": "string",
            "enum": [
              "illustrative",
              "syntax_checked",
              "sandbox_executed",
              "evidence_observed",
              "not_verifiable"
            ]
          },
          "intendedPurpose": {
            "type": "string",
            "minLength": 1
          },
          "verificationRequired": {
            "type": "boolean"
          },
          "materialClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "observedOutput": {
            "type": "object",
            "properties": {
              "fromExampleId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "stream": {
                "type": "string",
                "enum": [
                  "stdout",
                  "stderr"
                ]
              }
            },
            "required": [
              "fromExampleId",
              "stream"
            ],
            "additionalProperties": false
          },
          "expectedStdoutSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedStderrSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "exampleId",
          "requestedVerification",
          "intendedPurpose",
          "verificationRequired",
          "materialClaimIds"
        ],
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "receipts": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "protocol": {
                "type": "string",
                "const": "xpotato-example-verification-receipt-v1"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "human_local",
                  "synthetic_fixture"
                ]
              },
              "requestSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "exampleId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "inputArtifactSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "profileId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "profileSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "keyId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "principalId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "implementationSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "toolchainSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "runtime": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "additionalProperties": false
              },
              "verifier": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "parser",
                      "compiler",
                      "schema",
                      "sandbox"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "version"
                ],
                "additionalProperties": false
              },
              "boundarySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "startedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "finishedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "wallTimeMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 30000
              },
              "resourceOutcome": {
                "type": "string",
                "enum": [
                  "completed",
                  "timeout",
                  "memory_limit",
                  "pid_limit",
                  "output_limit",
                  "denied",
                  "environment_unavailable"
                ]
              },
              "result": {
                "type": "object",
                "properties": {
                  "class": {
                    "type": "string",
                    "enum": [
                      "illustrative",
                      "syntax_checked",
                      "sandbox_executed",
                      "evidence_observed",
                      "not_verifiable"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "not_run",
                      "blocked"
                    ]
                  },
                  "exitCode": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "signal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stdout": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 1048576
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1048576
                      }
                    },
                    "required": [
                      "text",
                      "sha256",
                      "bytes"
                    ],
                    "additionalProperties": false
                  },
                  "stderr": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 1048576
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1048576
                      }
                    },
                    "required": [
                      "text",
                      "sha256",
                      "bytes"
                    ],
                    "additionalProperties": false
                  },
                  "limitations": {
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  }
                },
                "required": [
                  "class",
                  "status",
                  "exitCode",
                  "signal",
                  "stdout",
                  "stderr",
                  "limitations"
                ],
                "additionalProperties": false
              },
              "signatureHex": {
                "type": "string",
                "pattern": "^[a-f0-9]{128}$"
              }
            },
            "required": [
              "protocol",
              "scope",
              "requestSha256",
              "exampleId",
              "inputArtifactSha256",
              "profileId",
              "profileSha256",
              "keyId",
              "principalId",
              "implementationSha256",
              "toolchainSha256",
              "runtime",
              "verifier",
              "boundarySha256",
              "startedAt",
              "finishedAt",
              "wallTimeMs",
              "resourceOutcome",
              "result",
              "signatureHex"
            ],
            "additionalProperties": false
          }
        },
        "fixtureTrust": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "principalId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "human_local",
                  "synthetic_fixture"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "revoked"
                ]
              },
              "publicKeySpkiDerBase64": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "publicKeySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "validFrom": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "validUntil": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "bindings": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "profileId": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "profileSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "implementationSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "toolchainSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "runtimeVersion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verifierVersion": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "profileId",
                    "profileSha256",
                    "implementationSha256",
                    "toolchainSha256",
                    "runtimeVersion",
                    "verifierVersion"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "keyId",
              "principalId",
              "scope",
              "status",
              "publicKeySpkiDerBase64",
              "publicKeySha256",
              "validFrom",
              "bindings"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "receipts"
      ],
      "additionalProperties": false
    },
    "receivedCitationMarkers": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sourceIds": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "start",
          "end",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "bodySha256",
    "sourceBundleSha256",
    "evidence",
    "claims",
    "ambiguities",
    "extracts",
    "examples"
  ],
  "additionalProperties": false
}
