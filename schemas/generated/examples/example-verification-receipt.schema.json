{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "xpotato-example-verification-receipt-v1"
    },
    "scope": {
      "type": "string",
      "enum": [
        "human_local",
        "synthetic_fixture"
      ]
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exampleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "inputArtifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "principalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "implementationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "toolchainSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "parser",
            "compiler",
            "schema",
            "sandbox"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "boundarySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "wallTimeMs": {
      "type": "number",
      "minimum": 0,
      "maximum": 30000
    },
    "resourceOutcome": {
      "type": "string",
      "enum": [
        "completed",
        "timeout",
        "memory_limit",
        "pid_limit",
        "output_limit",
        "denied",
        "environment_unavailable"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "illustrative",
            "syntax_checked",
            "sandbox_executed",
            "evidence_observed",
            "not_verifiable"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_run",
            "blocked"
          ]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 1048576
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          },
          "required": [
            "text",
            "sha256",
            "bytes"
          ],
          "additionalProperties": false
        },
        "stderr": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 1048576
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          },
          "required": [
            "text",
            "sha256",
            "bytes"
          ],
          "additionalProperties": false
        },
        "limitations": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "required": [
        "class",
        "status",
        "exitCode",
        "signal",
        "stdout",
        "stderr",
        "limitations"
      ],
      "additionalProperties": false
    },
    "signatureHex": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  },
  "required": [
    "protocol",
    "scope",
    "requestSha256",
    "exampleId",
    "inputArtifactSha256",
    "profileId",
    "profileSha256",
    "keyId",
    "principalId",
    "implementationSha256",
    "toolchainSha256",
    "runtime",
    "verifier",
    "boundarySha256",
    "startedAt",
    "finishedAt",
    "wallTimeMs",
    "resourceOutcome",
    "result",
    "signatureHex"
  ],
  "additionalProperties": false
}
