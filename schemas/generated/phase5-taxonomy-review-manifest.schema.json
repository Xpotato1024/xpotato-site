{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "reviewVersion": {
      "type": "string",
      "const": "legacy-taxonomy-review-v1"
    },
    "rawInventoryManifestPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "enum": [
              "blog_category",
              "note_subject",
              "tool_category",
              "tag"
            ]
          },
          "rawValue": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "active",
              "alias",
              "merge",
              "retire"
            ]
          },
          "targetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "supplementalTagIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "rationale": {
            "type": "string",
            "enum": [
              "canonical",
              "spelling_variant",
              "semantic_merge",
              "category_repartition",
              "typo",
              "one_off",
              "redundant_metadata"
            ]
          }
        },
        "required": [
          "namespace",
          "rawValue",
          "disposition",
          "supplementalTagIds",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "canonicalTags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "technology",
              "topic"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "archive": {
            "type": "boolean"
          },
          "indexable": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "retired"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "slug",
          "kind",
          "aliases",
          "archive",
          "indexable",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "reviewPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "reviewVersion",
    "rawInventoryManifestPayloadSha256",
    "decisions",
    "canonicalTags",
    "reviewPayloadSha256"
  ],
  "additionalProperties": false
}
