{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "candidateVersion": {
      "type": "string",
      "const": "legacy-portable-content-candidate-v1"
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "tagObjectSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "inventoryPayloadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "tag",
        "tagObjectSha",
        "commitSha",
        "inventoryPayloadSha256"
      ],
      "additionalProperties": false
    },
    "mappingPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateVersion": {
            "type": "string",
            "const": "legacy-portable-content-candidate-v1"
          },
          "legacyContentId": {
            "type": "string",
            "pattern": "^(?:blog|notes|projects|tools|pages):[^:\\0]+(?:\\/[^:\\0]+)*$"
          },
          "vNextContentId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "legacyPath": {
            "type": "string",
            "minLength": 1
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          },
          "collection": {
            "type": "string",
            "enum": [
              "blog",
              "notes",
              "projects",
              "tools",
              "pages"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "draft": {
            "type": "boolean"
          },
          "stableEditorialFields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "deferredTaxonomy": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "deferredMediaLocators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deferredInteractiveComponents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "legacyHtmlStatus": {
            "type": "string",
            "enum": [
              "none",
              "static_manual_review",
              "blocked_manual_review"
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "sourceBodySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "portable_as_is",
                  "requires_semantic_conversion",
                  "manual_review"
                ]
              },
              "candidateBodySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "validationErrors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "sourceBodySha256",
              "status",
              "validationErrors"
            ],
            "additionalProperties": false
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "taxonomy_mapping",
                "media_mapping",
                "interactive_mapping",
                "legacy_html_review",
                "semantic_mdx_conversion",
                "project_metadata_review"
              ]
            }
          },
          "candidatePayloadSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "candidateVersion",
          "legacyContentId",
          "vNextContentId",
          "legacyPath",
          "targetPath",
          "collection",
          "title",
          "description",
          "draft",
          "stableEditorialFields",
          "deferredTaxonomy",
          "deferredMediaLocators",
          "deferredInteractiveComponents",
          "legacyHtmlStatus",
          "body",
          "blockers",
          "candidatePayloadSha256"
        ],
        "additionalProperties": false
      }
    },
    "manifestPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "candidateVersion",
    "source",
    "mappingPayloadSha256",
    "candidates",
    "manifestPayloadSha256"
  ],
  "additionalProperties": false
}
