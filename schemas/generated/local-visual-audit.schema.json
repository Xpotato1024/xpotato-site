{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "protocol": {
      "type": "string",
      "const": "xpotato-private-visual-audit-v1"
    },
    "scope": {
      "type": "string",
      "enum": [
        "human_local",
        "synthetic_fixture"
      ]
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "human"
        },
        "principalId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "kind",
        "principalId"
      ],
      "additionalProperties": false
    },
    "publicationSafetyReviewed": {
      "type": "boolean",
      "const": true
    },
    "independence": {
      "type": "object",
      "properties": {
        "separateReview": {
          "type": "boolean",
          "const": true
        },
        "identitiesConfirmed": {
          "type": "boolean",
          "const": true
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "separateReview",
        "identitiesConfirmed",
        "basis"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "findingId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "assetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "findingId",
          "assetId",
          "severity",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "records": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "visualId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "candidateArtifactSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "independentContext": {
            "type": "boolean",
            "const": true
          },
          "checks": {
            "type": "object",
            "properties": {
              "factualAlignment": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "not_applicable"
                ]
              },
              "forbiddenImplications": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "rights": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "accessibility": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "manual_required"
                ]
              },
              "quality": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "manual_required"
                ]
              }
            },
            "required": [
              "factualAlignment",
              "forbiddenImplications",
              "rights",
              "accessibility",
              "quality"
            ],
            "additionalProperties": false
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "type": "string",
            "enum": [
              "approved",
              "revision_required",
              "blocked"
            ]
          },
          "auditSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "schemaVersion",
          "visualId",
          "candidateArtifactSha256",
          "independentContext",
          "checks",
          "findings",
          "outcome",
          "auditSha256"
        ],
        "additionalProperties": false
      }
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "pass",
        "revision_required",
        "blocked"
      ]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "protocol",
    "scope",
    "requestSha256",
    "reviewer",
    "publicationSafetyReviewed",
    "independence",
    "findings",
    "records",
    "conclusion",
    "reviewedAt"
  ],
  "additionalProperties": false
}
