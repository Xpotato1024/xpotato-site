{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "pagination": {
      "type": "object",
      "properties": {
        "blogPageSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "notesPageSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "blogPageSize",
        "notesPageSize"
      ],
      "additionalProperties": false
    },
    "feed": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "const": "/rss.xml"
        },
        "maxItems": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "contentMode": {
          "type": "string",
          "enum": [
            "summary",
            "full"
          ]
        }
      },
      "required": [
        "enabled",
        "path",
        "maxItems",
        "contentMode"
      ],
      "additionalProperties": false
    },
    "related": {
      "type": "object",
      "properties": {
        "maxItems": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "weights": {
          "type": "object",
          "properties": {
            "sameCollection": {
              "type": "number",
              "minimum": 0
            },
            "samePrimaryTaxonomy": {
              "type": "number",
              "minimum": 0
            },
            "sharedTechnologyTag": {
              "type": "number",
              "minimum": 0
            },
            "sharedTopicTag": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "sameCollection",
            "samePrimaryTaxonomy",
            "sharedTechnologyTag",
            "sharedTopicTag"
          ],
          "additionalProperties": false
        },
        "minimumScore": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "maxItems",
        "weights",
        "minimumScore"
      ],
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "route": {
          "type": "string",
          "const": "/search/"
        },
        "engine": {
          "type": "string",
          "const": "minisearch"
        },
        "engineVersion": {
          "type": "string",
          "const": "7.2.0"
        },
        "tokenizerId": {
          "type": "string",
          "const": "xpotato-ja-tech-bigram-v1"
        },
        "includeCollections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "blog",
              "notes",
              "projects",
              "tools",
              "pages"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "route",
        "engine",
        "engineVersion",
        "tokenizerId",
        "includeCollections"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "pagination",
    "feed",
    "related",
    "search"
  ],
  "additionalProperties": false
}
