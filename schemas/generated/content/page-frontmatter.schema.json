{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "updatedDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "draft": {
      "type": "boolean"
    },
    "legacyUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "canonicalOverride": {
          "type": "string",
          "format": "uri"
        },
        "noindex": {
          "type": "boolean"
        },
        "titleOverride": {
          "type": "string",
          "minLength": 1
        },
        "descriptionOverride": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "draft"
  ],
  "additionalProperties": false
}
