{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "mode": {
      "type": "string",
      "const": "draft"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "contentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bodySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "htmlSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "type": "string",
      "const": "private-markdown-draft-v1"
    },
    "displayedImageSha256s": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "productionEligible": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "jobId",
    "attemptId",
    "contentId",
    "inputSha256",
    "bodySha256",
    "htmlSha256",
    "profile",
    "displayedImageSha256s",
    "warnings",
    "productionEligible"
  ],
  "additionalProperties": false
}
