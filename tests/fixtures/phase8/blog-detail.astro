---
import { getCollection, type CollectionEntry } from "astro:content";
import {articleUrlId} from "@xpotato/content-contracts";
import identityMap from "../../../docs/migration/content-id-map-v1.json";
import BlogDetail from "../../../apps/site/src/components/content/BlogDetail.astro";

interface Props {
  entry: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const ids = new Set(identityMap.entries.filter((record) => record.collection === "blog").map((record) => record.vNextContentId));
  const heldEntries = (await getCollection("blog")).filter((entry) => ids.has(entry.data.id));
  if (ids.size !== 44 || heldEntries.length !== 44 || heldEntries.some((entry) => !entry.data.draft)) {
    throw new Error("Private migration fixture requires exactly the frozen 44 held Blog IDs");
  }
  return heldEntries
    .sort((left, right) => left.id.localeCompare(right.id))
    .map((entry) => ({ params: { slug: articleUrlId(entry.data.id) }, props: { entry } }));
}

const { entry } = Astro.props;
if (!entry.data.draft) throw new Error("Phase 8 fixture must render only held Blog entries");
---
<BlogDetail entry={entry} preview />
