# Deterministic text inputs whose byte identity participates in validation/artifacts.
.gitattributes text eol=lf
apps/site/public/_headers text eol=lf
.github/workflows/deploy-site.yml text eol=lf
.github/workflows/site-readback-only.yml text eol=lf
config/readback/*.json text eol=lf
templates/content/article.md text eol=lf

# Byte-preserved upstream files in selected or explicitly restored fixed releases.
# These whitespace diagnostics do not alter bytes or bypass artifact/license hashes.
vendor/browser-tools/prime-factorizer/*/native/rusqsieve/LICENSE-MPL whitespace=-blank-at-eol
vendor/browser-tools/prime-factorizer/*/src/site/mount.mjs whitespace=-blank-at-eol
vendor/browser-tools/prime-factorizer/*/vendor/emscripten/EMSCRIPTEN-LICENSE.txt whitespace=-blank-at-eol,-blank-at-eof
vendor/browser-tools/prime-factorizer/*/vendor/gmp-ecm/COPYING.LIB whitespace=-blank-at-eol
vendor/browser-tools/prime-factorizer/*/vendor/gmp/COPYING.LESSERv3 whitespace=-blank-at-eol
