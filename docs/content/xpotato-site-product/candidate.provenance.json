      {
        "sourceId": "site-product-revision-scope",
        "kind": "user_supplied",
        "publicDescription": "ポートフォリオに向けてXpotato Siteの紹介を拡充する依頼に基づき、この会話でAIが本文と構成図を作成した改稿下書き。実装の根拠は固定版の公開ソース。本文・図の本人承認、媒体公開、本番配信の完了を表す記録ではない。",
        "sourceRecordSha256": "b3d271efa212d39f153cc269afb08d59e225350e5db732ac8acd8dbdc5a49109"
      }
    ],
    "materialClaims": [
      {
        "claimId": "site-product-claim-01",
        "statementSha256": "e5e0be4c1d5db92d9398d899de7879ca34fa9fca825204cb6486995c2da4970e",
        "locator": {
          "blockIndex": 3
        },
        "claimType": "source_fact",
        "evidence": [
          {
            "evidenceId": "site-product-claim-01-evidence",
            "propositionSummary": "サイトは、公開ページを生成するAstro、自作CMSのPWA、保存を受け付ける編集APIに分かれています。PWAはブラウザで動き、対応端末ではホーム画面などに追加できるWebアプリです。公開ページとCMSは型やデザインを共有し、それぞれの役割に必要な処理を持ちます。",
            "propositionSha256": "b3fe864a671684c4117caac74f75cde8389ef561832677adba9900175086791e",
            "interpretation": "explicit",
            "sourceIds": [
              "site-product-architecture-1"
            ],
            "freshnessChecked": true
          }
        ],
        "limitations": [
          "基準は2026-11-24の固定main。コード・設計文書の確認を、全機能の実環境受入れ完了と扱わない。"
        ]
      },
      {
        "claimId": "site-product-claim-02",
        "statementSha256": "f3154b39e18f88c9c4b9a506855fe53b231faadefca4c7a62729fae4099294e0",
        "locator": {
          "blockIndex": 5
        },
        "claimType": "source_fact",
        "evidence": [
          {
            "evidenceId": "site-product-claim-02-evidence",
            "propositionSummary": "読者に届く本文は、ビルド時に生成した静的HTMLです。操作が必要な部分だけにJavaScriptを読み込み、記事を読むために編集画面の処理を動かす構成にはしていません。全文検索も事前に索引を作り、検索ページ側で処理します。",
            "propositionSha256": "74e792faa7df476f05354a4fd695696c67280218d2e4e0f7bd25f5362c22b7c8",
            "interpretation": "explicit",
            "sourceIds": [
