---
import type { GeneratedArchivePage } from "../model/discovery.js";
import type { TaxonomyRegistry } from "@xpotato/content-contracts";
import { buildTagDirectory } from "../model/tag-directory.js";
import { getLiveContentCatalog } from "../model/live-catalog.js";
import { selectWebIndexableCatalog } from "@xpotato/portable-content/catalog";
import { generateArchivePages } from "../model/discovery.js";
import TagLinks from "./TagLinks.astro";
import { groupArchiveTags } from "../model/archive-navigation.js";
interface Props {
  pages: readonly GeneratedArchivePage[];
  taxonomy: TaxonomyRegistry;
  collection: "blog" | "notes";
  currentRoute: string;
  root: boolean;
}
const { pages, taxonomy, collection, currentRoute, root } = Astro.props;
const scopes = pages.filter(
  (p) => p.page === 1 && (p.scope.kind === "category" || p.scope.kind === "subject"),
);
const tagPages =
  collection === "blog"
    ? generateArchivePages(
        selectWebIndexableCatalog(await getLiveContentCatalog()).map(
          (entry) => entry.discoveryRecord,
        ),
        taxonomy,
      )
    : [];
const tags = buildTagDirectory(tagPages, taxonomy);
const tagGroups = groupArchiveTags(tags, taxonomy);
const label = (scope: GeneratedArchivePage) => scope.title.replace(/^(記事|メモ): /u, "");
const currentScope = scopes.find(
  (scope) => scope.route === currentRoute || currentRoute.startsWith(`${scope.route}page/`),
);
const scopeLabel = collection === "blog" ? "主分類" : "メモの分類";
---

<details class="archive-categories">
  <summary class="disclosure-summary">
    {collection === "blog" ? "カテゴリを選ぶ" : "メモの分類を選ぶ"}
  </summary>
  <nav class="archive-category-options" aria-label={scopeLabel} tabindex="0">
    <a
      href={collection === "blog" ? "/articles/" : `/${collection}/`}
      aria-current={root ? "page" : undefined}
    >
      すべて
    </a>
    {scopes.map((scope) => (
      <a href={scope.route} aria-current={scope === currentScope ? "page" : undefined}>
        {label(scope)}
      </a>
    ))}
  </nav>
</details>
<div class="tag-actions">
  <a href="/series/">連載・学習コースの目次を見る →</a>
</div>
{tagGroups.map((group) => (
  <details class="archive-tags">
    <summary class="disclosure-summary">
      {group.label}
      <small>{group.tags.length}タグ</small>
    </summary>
    <nav aria-label={group.label}>
      <TagLinks tags={group.tags} currentRoute={currentRoute} />
    </nav>
  </details>
))}
{tags.length > 0 && (
  <div class="tag-actions">
    <a href="/articles/tags/">
      すべてのタグを見る（{tags.length}） <span aria-hidden="true">→</span>
    </a>
    <a href="/search/#tags">タグ名で探す</a>
  </div>
)}
