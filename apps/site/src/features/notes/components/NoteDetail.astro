---
import { render, type CollectionEntry } from "astro:content";
import type { ContentDiscoveryRecord } from "@xpotato/content-contracts";
import { contentComponents } from "../../../shared/content/index.js";
import RelatedContent from "../../discovery/components/RelatedContent.astro";
import { selectTableOfContents } from "../../../shared/blocks/transforms/table-of-contents.js";
import ContentLayout from "../../../shared/layouts/ContentLayout.astro";

interface Props {
  entry: CollectionEntry<"notes">;
  related: readonly ContentDiscoveryRecord[];
}

const { entry, related } = Astro.props;
const { Content, headings } = await render(entry);
---

<ContentLayout
  id={entry.data.id}
  collection="notes"
  title={entry.data.title}
  description={entry.data.description}
  taxonomy={[entry.data.subject, ...entry.data.tags].join(" ")}
  headings={selectTableOfContents(headings, entry.body ?? "")}
  seo={entry.data.seo}
  publication={
    entry.data.pubDate
      ? {
          pubDate: entry.data.pubDate,
          updatedDate: entry.data.updatedDate,
          draft: entry.data.draft,
        }
      : undefined
  }
>
  <div slot="metadata" class="article-meta">
    {entry.data.pubDate && <time datetime={entry.data.pubDate}>{entry.data.pubDate}</time>}
    {entry.data.updatedDate && (
      <span>
        更新 <time datetime={entry.data.updatedDate}>{entry.data.updatedDate}</time>
      </span>
    )}
  </div>
  <Content components={contentComponents} />
  <RelatedContent slot="after" items={related} />
</ContentLayout>
