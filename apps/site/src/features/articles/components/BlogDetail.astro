---
import { render, type CollectionEntry } from "astro:content";
import type { ContentDiscoveryRecord } from "@xpotato/content-contracts";
import { contentComponents } from "../../../shared/content/index.js";
import HistoricalReferenceLink from "../../discovery/components/HistoricalReferenceLink.astro";
import RelatedContent from "../../discovery/components/RelatedContent.astro";
import { selectTableOfContents } from "../../../shared/blocks/transforms/table-of-contents.js";
import ContentLayout from "../../../shared/layouts/ContentLayout.astro";
import BlogTaxonomy from './BlogTaxonomy.astro';
import ArticlePublication from './ArticlePublication.astro';
import { blogBreadcrumbs, blogTags, categoryLineage, categoryArchiveRoute } from "../model/blog-taxonomy.js";
import { taxonomyRegistry } from '../../../../../../content/registry/taxonomy/index.js';
import { siteConfig } from '../../../shared/lib/site-config.js';
import { contentMediaContext } from "../../../shared/media/media-context.js";
import { deriveContentSeo } from "../../discovery/model/seo.js";

interface Props {
  entry: CollectionEntry<"blog">;
  related?: readonly ContentDiscoveryRecord[];
  preview?: boolean;
}

const { entry, related = [], preview = false } = Astro.props;
const { Content, headings } = await render(entry);
const pubDate=entry.data.pubDate;
if(!entry.data.draft&&!pubDate)throw new Error('PUBLISHED_ARTICLE_DATE_REQUIRED');
const publication=pubDate?{pubDate,updatedDate:entry.data.updatedDate,draft:entry.data.draft,preview}:undefined;
const blogContentComponents = { ...contentComponents, a: HistoricalReferenceLink };
const seo = preview ? { ...entry.data.seo, noindex: true } : entry.data.seo;
const isCandidate = contentMediaContext(entry.data.id)?.candidate === true;
const linkable = !entry.data.draft && !seo?.noindex && !preview && !isCandidate;
const category = categoryLineage(entry.data.category, taxonomyRegistry).at(-1)!;
const tags = blogTags(entry.data.tags, taxonomyRegistry, linkable);
const purposes = tags.filter(tag => tag.kind === "purpose");
const metadata=deriveContentSeo({title:entry.data.title,description:entry.data.description,route:Astro.url.pathname,canonicalOrigin:siteConfig.site.canonicalOrigin,seo});
const breadcrumbs = linkable ? blogBreadcrumbs({categoryId:category.id,title:entry.data.title,canonical:metadata.canonical,origin:siteConfig.site.canonicalOrigin,taxonomy:taxonomyRegistry}) : undefined;
---

<ContentLayout
  id={entry.data.id}
  collection="blog"
  title={entry.data.title}
  description={entry.data.description}
  taxonomy={[...categoryLineage(category.id,taxonomyRegistry).map(term=>term.label),...tags.map(tag=>tag.label)].join(' ')}
  headings={selectTableOfContents(headings, entry.body ?? "")}
  seo={seo}
  breadcrumbs={breadcrumbs}
  publication={publication}
>
  <div slot="metadata" class="blog-metadata">
    {pubDate ? <ArticlePublication pubDate={pubDate} updatedDate={entry.data.updatedDate} purposes={purposes} preview={preview} /> : <span class="article-meta">公開日未定の下書き</span>}
    <BlogTaxonomy category={{label:category.label,href:linkable ? categoryArchiveRoute(category) : undefined}} tags={tags.filter(tag => tag.kind !== "purpose")} />
  </div>
  <Content components={blogContentComponents} />
  <RelatedContent slot="after" items={preview ? [] : related} />
</ContentLayout>
