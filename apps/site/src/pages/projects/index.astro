---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { selectWebIndexableCatalog } from "../../lib/catalog.js";
import { sortNewestFirst } from "../../lib/discovery.js";
import { getLiveContentCatalog } from "../../lib/live-catalog.js";

const projects = sortNewestFirst(
  selectWebIndexableCatalog(await getLiveContentCatalog())
    .filter((entry) => entry.discoveryRecord.collection === "projects")
    .map((entry) => entry.discoveryRecord),
);
---

<BaseLayout title="制作物" description="文書作成、データ解析、運用のために作ったプロジェクト。">
  <main id="main-content" class="archive">
    <div class="page-heading"><p class="eyebrow">Selected work</p><h1>制作物</h1><p>手元の課題から、動くものを作る。</p></div>
    {projects.length === 0 ? (
      <p>まだ公開されたプロジェクトはありません。</p>
    ) : (
      <ul class="fixed-content-list">
        {projects.map((project) => (
          <li>
            <article>
              <h2><a href={project.route}>{project.title} <span aria-hidden="true">↗</span></a></h2>
              <p>{project.description}</p>
            </article>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>
