---
import tagCssHref from "../../../features/discovery/styles/tag-directory.css?url&no-inline";
import BaseLayout from "../../../shared/layouts/BaseLayout.astro";
import TagLinks from "../../../features/discovery/components/TagLinks.astro";
import { taxonomyRegistry } from "../../../../../../content/registry/taxonomy/index.js";
import { selectWebIndexableCatalog } from "@xpotato/portable-content/catalog";
import { generateArchivePages, paginate } from "../../../features/discovery/model/discovery.js";
import { getLiveContentCatalog } from "../../../features/discovery/model/live-catalog.js";
import {
  buildTagDirectory,
  tagDirectoryRoute,
  TAG_PAGE_SIZE,
  type DirectoryTag,
} from "../../../features/discovery/model/tag-directory.js";

export async function getStaticPaths() {
  const catalog = selectWebIndexableCatalog(await getLiveContentCatalog());
  const tags = buildTagDirectory(
    generateArchivePages(
      catalog.map((entry) => entry.discoveryRecord),
      taxonomyRegistry,
    ),
    taxonomyRegistry,
  );
  const chunks = tags.length ? paginate(tags, TAG_PAGE_SIZE) : [[]];
  return chunks.map((tagsOnPage, index) => ({
    params: { page: index === 0 ? undefined : `page/${index + 1}` },
    props: { tags: tagsOnPage, page: index + 1, totalPages: chunks.length, total: tags.length },
  }));
}
interface Props {
  tags: readonly DirectoryTag[];
  page: number;
  totalPages: number;
  total: number;
}
const { tags, page, totalPages, total } = Astro.props;
---

<BaseLayout
  pageCssHrefs={[tagCssHref]}
  title={page === 1 ? "記事のタグ一覧" : `記事のタグ一覧 (${page})`}
  description="タグから関連記事を探せます。"
>
  <main id="main-content" class="tag-directory">
    <div class="page-heading">
      <h1>記事のタグ一覧</h1>
      <p>タグ名順に並んでいます。数字は関連記事の件数です。</p>
    </div>
    <div class="tag-actions">
      <a href="/articles/">← 記事一覧へ</a>
      <a href="/search/#tags">タグ名で探す →</a>
    </div>
    {total ? (
      <>
        <p>
          全{total}タグ・{(page - 1) * TAG_PAGE_SIZE + 1}〜{Math.min(page * TAG_PAGE_SIZE, total)}
          件を表示
        </p>
        <nav aria-label="記事のタグ">
          <TagLinks tags={tags} />
        </nav>
      </>
    ) : (
      <p>公開された記事のタグはまだありません。</p>
    )}
    {totalPages > 1 && (
      <nav class="pagination" aria-label="タグ一覧のページ移動">
        {page > 1 && (
          <a rel="prev" href={tagDirectoryRoute(page - 1)}>
            ← 前のページ
          </a>
        )}
        <span>
          {page} / {totalPages}
        </span>
        {page < totalPages && (
          <a rel="next" href={tagDirectoryRoute(page + 1)}>
            次のページ →
          </a>
        )}
      </nav>
    )}
  </main>
</BaseLayout>
