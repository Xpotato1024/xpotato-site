---
import ArchivePage from "../../features/discovery/components/ArchivePage.astro";
import { taxonomyRegistry } from "../../../../../content/registry/taxonomy/index.js";
import { selectWebIndexableCatalog } from "@xpotato/portable-content/catalog";
import { generateArchivePages } from "../../features/discovery/model/discovery.js";
import { getLiveContentCatalog } from "../../features/discovery/model/live-catalog.js";

const catalog = selectWebIndexableCatalog(await getLiveContentCatalog());
const page = generateArchivePages(
  catalog.map((entry) => entry.discoveryRecord),
  taxonomyRegistry,
).find(
  (candidate) =>
    candidate.collection === "blog" && candidate.scope.kind === "root" && candidate.page === 1,
);
if (!page) throw new Error("Blog root archive page was not generated");
---

<ArchivePage page={page} />
