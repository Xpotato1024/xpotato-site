---
import ArchivePage from "../../components/content/ArchivePage.astro";
import { taxonomyRegistry } from "../../content-registry/taxonomy/index.js";
import { selectWebIndexableCatalog } from "../../lib/catalog.js";
import { generateArchivePages } from "../../lib/discovery.js";
import { getLiveContentCatalog } from "../../lib/live-catalog.js";

const catalog = selectWebIndexableCatalog(await getLiveContentCatalog());
const page = generateArchivePages(catalog.map((entry) => entry.discoveryRecord), taxonomyRegistry).find(
  (candidate) => candidate.collection === "blog" && candidate.scope.kind === "root" && candidate.page === 1,
);
if (!page) throw new Error("Blog root archive page was not generated");
---

<ArchivePage page={page} />
