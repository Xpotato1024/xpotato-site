---
import { getCollection, type CollectionEntry } from "astro:content";
import {articleUrlId} from "@xpotato/content-contracts";
import type { ContentDiscoveryRecord } from "@xpotato/content-contracts";
import ArchivePage from "../../features/discovery/components/ArchivePage.astro";
import BlogDetail from "../../features/articles/components/BlogDetail.astro";
import { taxonomyRegistry } from "../../../../../content/registry/taxonomy/index.js";
import {
  selectPublishedCatalog,
  selectWebIndexableCatalog,
} from "@xpotato/portable-content/catalog";
import {
  generateArchivePages,
  selectDynamicArchivePages,
  selectRelated,
} from "../../features/discovery/model/discovery.js";
import { getLiveContentCatalog } from "../../features/discovery/model/live-catalog.js";

type BlogRouteProps =
  | { kind: "archive"; page: import("../../features/discovery/model/discovery.js").GeneratedArchivePage }
  | { kind: "content"; entry: CollectionEntry<"blog">; related: readonly ContentDiscoveryRecord[] };

export async function getStaticPaths() {
  const catalog = await getLiveContentCatalog();
  const publishedById = new Map(
    selectPublishedCatalog(catalog)
      .filter((entry) => entry.source.collection === "blog")
      .map((entry) => [entry.discoveryRecord.contentId, entry] as const),
  );
  const discoverable = selectWebIndexableCatalog(catalog).map((entry) => entry.discoveryRecord);
  const candidates = await getCollection("blog");
  const contentPaths = candidates.flatMap((entry) => {
    const catalogEntry = publishedById.get(entry.data.id);
    if (!catalogEntry) return [];
    const related = selectRelated(catalogEntry.discoveryRecord, discoverable, taxonomyRegistry);
    return [{ params: { slug: articleUrlId(entry.data.id) }, props: { kind: "content" as const, entry, related } }];
  });
  const archivePaths = selectDynamicArchivePages(generateArchivePages(discoverable, taxonomyRegistry), "blog")
    .map((page) => ({
      params: { slug: page.route.slice("/articles/".length).replace(/\/$/u, "") },
      props: { kind: "archive" as const, page },
    }));
  return [...contentPaths, ...archivePaths];
}

const props = Astro.props as BlogRouteProps;
---

{props.kind === "archive" ? (
  <ArchivePage page={props.page} />
) : (
  <BlogDetail entry={props.entry} related={props.related} />
)}
