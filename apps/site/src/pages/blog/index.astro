---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { discoveryProfile } from "../../content-registry/discovery.js";
import { paginate } from "../../lib/discovery.js";

const entries = (await getCollection("blog", ({ data }) => !data.draft)).sort((left, right) => right.data.pubDate.localeCompare(left.data.pubDate));
const firstPage = paginate(entries, discoveryProfile.pagination.blogPageSize)[0] ?? [];
---
<BaseLayout title="Blog">
  <main><h1>Blog</h1><ul>{firstPage.map((entry) => <li><a href={`/blog/${entry.id}/`}>{entry.data.title}</a></li>)}</ul></main>
</BaseLayout>
