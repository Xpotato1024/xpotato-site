---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { contentComponents } from "../shared/content/index.js";
import { selectTableOfContents } from "../shared/blocks/transforms/table-of-contents.js";
import ContentLayout from "../shared/layouts/ContentLayout.astro";
import { selectPublishedCatalog } from "@xpotato/portable-content/catalog";
import { getLiveContentCatalog } from "../features/discovery/model/live-catalog.js";
import ContactDetails from "../features/pages/components/ContactDetails.astro";

export async function getStaticPaths() {
  const catalog = await getLiveContentCatalog();
  const publishedIds = new Set(
    selectPublishedCatalog(catalog)
      .filter((entry) => entry.source.collection === "pages")
      .map((entry) => entry.discoveryRecord.contentId),
  );
  return (await getCollection("pages")).flatMap((entry) =>
    publishedIds.has(entry.data.id) ? [{ params: { page: entry.id }, props: { entry } }] : [],
  );
}

const { entry } = Astro.props as { entry: CollectionEntry<"pages"> };
const { Content, headings } = await render(entry);
---

<ContentLayout id={entry.data.id} collection="pages" title={entry.data.title} description={entry.data.description} seo={entry.data.seo} headings={selectTableOfContents(headings, entry.body ?? "")}>
  <Content components={contentComponents} />
  {entry.id === "contact" && <ContactDetails />}
</ContentLayout>
