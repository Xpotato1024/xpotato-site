---
import tagCssHref from "../../styles/tag-directory.css?url&no-inline";
import BaseLayout from "../../layouts/BaseLayout.astro";
import searchCssHref from "../../styles/search.css?url";
import TagSearch from '../../components/content/TagSearch.astro';
---
<BaseLayout pageCssHrefs={[searchCssHref,tagCssHref]} title="検索" description="サイト内検索" noindex>
  <main id="main-content" data-search-client>
    <div class="search-page-heading"><h1>検索</h1><a href="#tags">タグから探す ↓</a></div>
    <div class="search-controls">
    <form id="search-form" role="search" aria-label="キーワード検索" action="/search/" method="get">
      <div class="search-field-label"><label for="search-query">キーワード</label></div>
      <div class="search-input-row">
      <div class="search-text-field"><input class="control-field" id="search-query" name="q" type="text" role="searchbox" inputmode="search" enterkeyhint="search" autocomplete="off" autocapitalize="none" spellcheck="false" /><button type="reset" class="search-clear" aria-label="検索語をクリア" disabled><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m5 5 10 10M15 5 5 15" /></svg></button></div>
      <button class="action-primary" type="submit">検索</button>
      </div>
    </form>
    </div>
    <section class="search-results-section" aria-labelledby="search-results-heading">
    <div class="search-section-heading"><h2 id="search-results-heading">検索結果</h2>
    <p id="search-status" aria-live="polite">検索語を入力してください。</p></div>
    <ol id="search-results" aria-busy="false"></ol>
    </section>
    <TagSearch />
  </main>
  <script>
    import "../../search/search-client.js";
    import '../../search/tag-search-client.js';
  </script>
</BaseLayout>
