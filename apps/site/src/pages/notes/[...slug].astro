---
import { getCollection, type CollectionEntry } from "astro:content";
import type { ContentDiscoveryRecord } from "@xpotato/content-contracts";
import ArchivePage from "../../components/content/ArchivePage.astro";
import NoteDetail from "../../components/content/NoteDetail.astro";
import { taxonomyRegistry } from "../../content-registry/taxonomy/index.js";
import { selectPublishedCatalog, selectWebIndexableCatalog } from "../../lib/catalog.js";
import { generateArchivePages, selectDynamicArchivePages, selectRelated } from "../../lib/discovery.js";
import { getLiveContentCatalog } from "../../lib/live-catalog.js";

type NoteRouteProps =
  | { kind: "archive"; page: import("../../lib/discovery.js").GeneratedArchivePage }
  | { kind: "content"; entry: CollectionEntry<"notes">; related: readonly ContentDiscoveryRecord[] };

export async function getStaticPaths() {
  const catalog = await getLiveContentCatalog();
  const publishedById = new Map(
    selectPublishedCatalog(catalog)
      .filter((entry) => entry.source.collection === "notes")
      .map((entry) => [entry.discoveryRecord.contentId, entry] as const),
  );
  const discoverable = selectWebIndexableCatalog(catalog).map((entry) => entry.discoveryRecord);
  const candidates = await getCollection("notes");
  const contentPaths = candidates.flatMap((entry) => {
    const catalogEntry = publishedById.get(entry.data.id);
    if (!catalogEntry) return [];
    const related = selectRelated(catalogEntry.discoveryRecord, discoverable, taxonomyRegistry);
    return [{ params: { slug: entry.id }, props: { kind: "content" as const, entry, related } }];
  });
  const archivePaths = selectDynamicArchivePages(generateArchivePages(discoverable, taxonomyRegistry), "notes")
    .map((page) => ({
      params: { slug: page.route.slice("/notes/".length).replace(/\/$/u, "") },
      props: { kind: "archive" as const, page },
    }));
  return [...contentPaths, ...archivePaths];
}

const props = Astro.props as NoteRouteProps;
---

{props.kind === "archive" ? (
  <ArchivePage page={props.page} />
) : (
  <NoteDetail entry={props.entry} related={props.related} />
)}
