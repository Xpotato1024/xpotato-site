---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const entries = (await getCollection("notes", ({ data }) => !data.draft)).sort((left, right) => right.data.pubDate.localeCompare(left.data.pubDate));
---
<BaseLayout title="Notes"><main><h1>Notes</h1><ul>{entries.map((entry) => <li><a href={`/notes/${entry.id}/`}>{entry.data.title}</a></li>)}</ul></main></BaseLayout>
