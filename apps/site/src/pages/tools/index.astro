---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { selectWebIndexableCatalog } from "../../lib/catalog.js";
import { sortNewestFirst } from "../../lib/discovery.js";
import { getLiveContentCatalog } from "../../lib/live-catalog.js";

const tools = sortNewestFirst(
  selectWebIndexableCatalog(await getLiveContentCatalog())
    .filter((entry) => entry.discoveryRecord.collection === "tools")
    .map((entry) => entry.discoveryRecord),
);
---

<BaseLayout title="ツール" description="ブラウザで開いて使える、小さな計算ツール。">
  <main id="main-content" class="archive">
    <div class="page-heading"><p class="eyebrow">Utilities</p><h1>ツール</h1><p>ブラウザで開いて、すぐに試せるもの。</p></div>
    {tools.length === 0 ? (
      <p>まだ公開されたツールはありません。</p>
    ) : (
      <ul class="fixed-content-list">{tools.map((tool) => <li><article><h2><a href={tool.route}>{tool.title} <span aria-hidden="true">↗</span></a></h2><p>{tool.description}</p></article></li>)}</ul>
    )}
  </main>
</BaseLayout>
