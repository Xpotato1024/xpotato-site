---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { selectWebIndexableCatalog } from "../../lib/catalog.js";
import { sortNewestFirst } from "../../lib/discovery.js";
import { getLiveContentCatalog } from "../../lib/live-catalog.js";

const tools = sortNewestFirst(
  selectWebIndexableCatalog(await getLiveContentCatalog())
    .filter((entry) => entry.discoveryRecord.collection === "tools")
    .map((entry) => entry.discoveryRecord),
);
---

<BaseLayout title="Tools" description="公開中のツール一覧です。">
  <main id="main-content">
    <h1>Tools</h1>
    {tools.length === 0 ? (
      <p>まだ公開されたツールはありません。</p>
    ) : (
      <ul>{tools.map((tool) => <li><a href={tool.route}>{tool.title}</a></li>)}</ul>
    )}
  </main>
</BaseLayout>
