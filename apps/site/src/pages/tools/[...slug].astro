---
import { getCollection, render, type CollectionEntry } from "astro:content";
import type { ContentDiscoveryRecord } from "@xpotato/content-contracts";
import { contentComponents } from "../../components/content/index.js";
import RelatedContent from "../../components/content/RelatedContent.astro";
import { selectTableOfContents } from "../../lib/content/table-of-contents.js";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { taxonomyRegistry } from "../../content-registry/taxonomy/index.js";
import { selectPublishedCatalog, selectWebIndexableCatalog } from "../../lib/discovery/catalog.js";
import { selectToolArticles } from "../../lib/discovery/discovery.js";
import { getLiveContentCatalog } from "../../lib/discovery/live-catalog.js";
import ToolReleaseNotice from "../../components/content/ToolReleaseNotice.astro";
import PrimeOffline from "../../components/content/PrimeOffline.astro";
import ToolContact from "../../components/content/ToolContact.astro";
import { interactiveModuleRegistry, toolBindings } from "../../content-registry/interactive/index.js";
import { requireActiveInteractiveModule } from "../../content-registry/interactive/resolve.js";
import { browserToolReleases } from "../../content-registry/interactive/releases.js";
import { browserToolManifestSources } from "../../content-registry/interactive/manifest-sources.js";
import {generatedToolDisplayPolicies} from "../../content-registry/interactive/generated/display.js";
import { describeBrowserToolRelease } from "@xpotato/site-validators/browser-tool-display";

export async function getStaticPaths() {
  const catalog = await getLiveContentCatalog();
  const publishedById = new Map(
    selectPublishedCatalog(catalog)
      .filter((entry) => entry.source.collection === "tools")
      .map((entry) => [entry.discoveryRecord.contentId, entry] as const),
  );
  const discoverable = selectWebIndexableCatalog(catalog).map((entry) => entry.discoveryRecord);
  const entries = await getCollection("tools");
  return entries.flatMap((entry) => {
    const catalogEntry = publishedById.get(entry.data.id);
    if (!catalogEntry) return [];
    return [{
      params: { slug: entry.id },
      props: { entry, related: selectToolArticles(catalogEntry.discoveryRecord, discoverable, taxonomyRegistry) },
    }];
  });
}

const { entry, related } = Astro.props as {
  entry: CollectionEntry<"tools">;
  related: readonly ContentDiscoveryRecord[];
};
const { Content, headings } = await render(entry);
const primaryBindings = toolBindings.filter(binding => binding.contentId === entry.data.id && binding.status === "active");
if (primaryBindings.length !== 1) throw new Error(`Tool page requires exactly one primary binding: ${entry.data.id}`);
const primaryModule = requireActiveInteractiveModule(interactiveModuleRegistry, primaryBindings[0]!.moduleId, "tools");
if (primaryModule.role !== "primary_tool") throw new Error(`Tool page binding is not primary: ${primaryModule.id}`);
const release = describeBrowserToolRelease({ module: primaryModule, pins: browserToolReleases, manifestSources: browserToolManifestSources,display:(generatedToolDisplayPolicies as Record<string,unknown>)[primaryModule.id] as never });
---

<ContentLayout
  id={entry.data.id}
  collection="tools"
  title={entry.data.title}
  description={entry.data.description}
  taxonomy={[entry.data.category, ...entry.data.tags].join(" ")}
  headings={selectTableOfContents(headings, entry.body ?? "")}
  seo={entry.data.seo}
>
  {release?.toolId === "prime-factorizer" && <div slot="metadata" class="prime-intro-links" data-search-exclude="true">
    <a class="prime-offline-link" href="#tool-demo">さっそく試してみる <span aria-hidden="true">↓</span></a>
    <a class="prime-offline-link" data-prime-offline-guide-link href="#prime-offline-guide">オフライン保存の手順を見る <span aria-hidden="true">→</span></a>
  </div>}
  <Content components={contentComponents} />
  {release?.toolId === "prime-factorizer" && <PrimeOffline />}
  {release && <ToolReleaseNotice release={release} />}
  <ToolContact toolId={release?.toolId} />
  <RelatedContent slot="after" items={related} heading="関連記事" />
</ContentLayout>

<style>
  :global(.content-heading:has(.prime-offline-link)) { padding-bottom: .75rem; margin-bottom: 1.5rem; }
  .prime-intro-links { display: flex; flex-direction: column; align-items: flex-start; margin-top: .5rem; }
  .prime-offline-link { display: inline-flex; align-items: center; gap: .4em; min-height: var(--control-min-size); color: var(--accent); font-size: .9rem; text-underline-offset: .2em; }
  .prime-offline-link span { flex-shrink: 0; }
</style>
