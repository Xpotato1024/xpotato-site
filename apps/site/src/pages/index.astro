---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import WorkshopPreview from "../components/WorkshopPreview.astro";
import WorkshopPhoto from "../components/WorkshopPhoto.astro";
import ArticleCard from "../components/content/ArticleCard.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import { readHomeWorkshopBuildPictures } from "../lib/home/home-workshop-build.js";
import { getLiveContentCatalog } from "../lib/discovery/live-catalog.js";
import { selectWebIndexableCatalog } from "../lib/discovery/catalog.js";
import { sortNewestFirst } from "../lib/discovery/discovery.js";
const publicEntries = selectWebIndexableCatalog(await getLiveContentCatalog());
const projectOrder = ["pandocker-x", "csv2g", "repo-audit", "xpotato-site", "meidaisai-mac", "syu-katsu-management"];
const projects = projectOrder.flatMap(slug => publicEntries.filter(e => e.source.collection === "projects" && e.source.slug === slug).map(e => e.discoveryRecord));
const articles = sortNewestFirst(publicEntries.filter(e => e.source.collection === "blog").map(e => e.discoveryRecord)).slice(0, 3);
const featuredTools = sortNewestFirst(publicEntries.filter(e => e.source.collection === "tools" && e.discoveryRecord.featured).map(e => e.discoveryRecord)).slice(0, 3);
// Existing private reviews retain their isolated URL; ordinary builds use the exact frozen Git photo in the existing Worker artifact.
const workshopPreview = import.meta.env.SITE_PREVIEW_WORKSHOP === "1";
const workshopAsset = workshopPreview ? null : await readHomeWorkshopBuildPictures();
---
<BaseLayout image={workshopAsset?.socialImage} title="ものづくりとプログラミングの記録" description="Xpotatoの技術とものづくりの記録。ロボティクスやプログラミングの試行錯誤、制作物、教育資料、ブラウザで使える小さなツールをまとめています。">
  <main id="main-content" class="home home-fullbleed">
    <section class="intro home-intro home-intro-fullbleed" aria-labelledby="home-title">
      {workshopPreview ? <WorkshopPreview /> : workshopAsset && <WorkshopPhoto asset={workshopAsset.asset} mobile={workshopAsset.mobile} />}
      <div class="intro-copy">
        <h1 id="home-title" lang="en"><span>Think.</span> <span>Build.</span> <span>Run.</span></h1>
        <div class="intro-links">
          <a class="button-glass" href="/projects/"><span>制作物を見る</span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
    <section class="home-introduction" aria-label="サイトについて">
      <nav class="home-topics" aria-label="ものづくり、プログラミング、日々の試行錯誤。">
        <a href="/projects/"><span class="home-topic-title">ものづくり</span><span class="home-topic-destination">制作物 <span aria-hidden="true">→</span></span></a>
        <a href="/tools/"><span class="home-topic-title">プログラミング</span><span class="home-topic-destination">ツール <span aria-hidden="true">→</span></span></a>
        <a href="/articles/"><span class="home-topic-title">日々の試行錯誤</span><span class="home-topic-destination">記事 <span aria-hidden="true">→</span></span></a>
      </nav>
      <a href="/about/">サイト紹介 <span aria-hidden="true">→</span></a>
    </section>
    <section class="home-projects" aria-labelledby="projects-heading">
      <div class="section-heading"><h2 id="projects-heading">つくったもの</h2><a href="/projects/">制作物一覧 <span aria-hidden="true">→</span></a></div>
      <ProjectCarousel projects={projects} />
    </section>
    {featuredTools.length > 0 && <section class="records" aria-labelledby="tools-heading">
      <div class="section-heading"><h2 id="tools-heading">ブラウザで使えるツール</h2><a href="/tools/">ツール一覧 <span aria-hidden="true">→</span></a></div>
      <ul class="home-article-list">{featuredTools.map(item => <li><article><h3><a href={item.route}>{item.title}</a></h3><p>{item.description}</p></article></li>)}</ul>
    </section>}
    <section class="records" aria-labelledby="records-heading">
      <div class="section-heading"><h2 id="records-heading">書きとめたこと</h2><div class="record-links"><a href="/articles/">記事 <span aria-hidden="true">→</span></a><a href="/notes/">メモ <span aria-hidden="true">→</span></a></div></div>
      {articles.length ? <ul class="home-article-list">{articles.map(item => <li><ArticleCard item={item} headingLevel="h3" /></li>)}</ul> : <div class="empty-state"><p>公開記事は準備中です。日常のことや思いつきはメモに書きとめます。</p><a href="/notes/">メモを読む <span aria-hidden="true">→</span></a></div>}
    </section>
    <section class="home-contact" aria-label="お問い合わせ">
      <p>制作物や記事についてのご質問・ご連絡はこちらへ。</p>
      <a href="/contact/">問い合わせ <span aria-hidden="true">→</span></a>
    </section>
  </main>
</BaseLayout>
