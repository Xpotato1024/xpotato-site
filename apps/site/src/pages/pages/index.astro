---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { selectWebIndexableCatalog } from "../../lib/catalog.js";
import { sortNewestFirst } from "../../lib/discovery.js";
import { getLiveContentCatalog } from "../../lib/live-catalog.js";

const pages = sortNewestFirst(
  selectWebIndexableCatalog(await getLiveContentCatalog())
    .filter((entry) => entry.discoveryRecord.collection === "pages")
    .map((entry) => entry.discoveryRecord),
);
---

<BaseLayout title="Pages" description="公開中のページ一覧です。">
  <main>
    <h1>Pages</h1>
    {pages.length === 0 ? (
      <p>公開中のページはありません。</p>
    ) : (
      <ul>{pages.map((page) => <li><a href={page.route}>{page.title}</a></li>)}</ul>
    )}
  </main>
</BaseLayout>
