---
import type { UpdateEvent } from '../lib/home/update-activity.js';
import { updateActivity, updateLabels } from '../lib/home/update-activity.js';
interface Props { events: UpdateEvent[] }
const { events } = Astro.props;
// Only absolute dates are rendered at build time. Never freeze a relative week window in HTML.
const { latest, banner } = updateActivity(events, Date.now());
---
<section class="home-updates" aria-labelledby="updates-heading" data-update-activity data-update-events={JSON.stringify(events)}>
  <div class="home-update-band">
    <h2 id="updates-heading">新着・更新</h2>
    <div data-update-banner>
      {banner ? <a href={banner.route}><span class="home-update-kind">{updateLabels[banner.kind]} · {banner.action}</span><span class="home-update-title">{banner.title}</span><span aria-hidden="true">→</span></a> : <span>ツール・制作物の更新記録はありません</span>}
    </div>
    <p class="home-update-latest" data-update-latest>{latest ? <>最終更新 <time datetime={latest.date}>{latest.date}</time></> : '更新記録はありません'}</p>
  </div>
  <div class="home-update-activity" data-update-view>
    <p class="home-update-fallback">週ごとの更新状況はJavaScriptが有効な場合に表示します。</p>
  </div>
</section>
<script>
  import { mountUpdateActivity } from '../lib/home/update-activity-client.js';
  document.querySelectorAll<HTMLElement>('[data-update-activity]').forEach(mountUpdateActivity);
</script>
