---
import PrimeFactorizer from "../islands/PrimeFactorizer.js";
import PrimeFactorizerStyles from "./PrimeFactorizerStyles.astro";
interface Props { mediaQuery?: string }
const { mediaQuery } = Astro.props;
if (!mediaQuery) throw new Error("media hydration requires a registry-owned mediaQuery");
---
<PrimeFactorizerStyles />
<PrimeFactorizer client:media={mediaQuery} />
