---
import { getToolIssueLink } from "../../lib/contact.js";
interface Props { toolId?: string | undefined; }
const issue = getToolIssueLink(Astro.props.toolId);
---
<aside class="tool-contact" aria-label="問い合わせと不具合報告" data-search-exclude="true">
  <p>使い方の質問・ご相談は<a href="/contact/">問い合わせ</a>へ。{issue && <><a href={issue.href} rel="noopener noreferrer">GitHubでIssueを作成</a>できます。</>}</p>
  {issue && <p>サイト表示の報告先も<a href="/contact/#contact-bugs">問い合わせページ</a>にあります。</p>}
</aside>
<style>
  .tool-contact { margin-block: 1.5rem; border-top: 1px solid var(--border-divider); padding-top: .75rem; font-size: .9rem; overflow-wrap: anywhere; }
  .tool-contact p { margin-block: .5rem; }
</style>
