---
import { interactiveComponentImports } from "../../content-registry/interactive/component-imports.js";
import { interactiveModuleRegistry } from "../../content-registry/interactive/index.js";
import { requireActiveInteractiveModule } from "../../content-registry/interactive/resolve.js";

import ToolReleaseNotice from "./ToolReleaseNotice.astro";
import {generatedToolDisplayPolicies} from "../../content-registry/interactive/generated/display.js";
import { describeBrowserToolRelease } from "@xpotato/site-validators/browser-tool-display";
import { browserToolReleases } from "../../content-registry/interactive/releases.js";
import { browserToolManifestSources } from "../../content-registry/interactive/manifest-sources.js";
import { toolReleaseFontText } from "../../lib/tools/tool-release-font-text.mjs";

interface Props {
  module: string;
  title?: string;
  description?: string;
}
const { module: moduleId, title, description } = Astro.props;
const routeCollection = Astro.url.pathname.split("/").filter(Boolean)[0];
const collection = routeCollection === "articles" ? "blog" : routeCollection === "blog" || routeCollection === "notes" || routeCollection === "projects" || routeCollection === "tools"
  ? routeCollection
  : "pages";
const record = requireActiveInteractiveModule(interactiveModuleRegistry, moduleId, collection);
const release = describeBrowserToolRelease({ module: record, pins: browserToolReleases, manifestSources: browserToolManifestSources,display:(generatedToolDisplayPolicies as Record<string,unknown>)[record.id] as never });
// The dedicated Tool page owns the primary release notice after all help text.
// Inline demos retain their own notice at the embedding point.
const pageOwnsReleaseNotice = collection === "tools" && record.role === "primary_tool";
const isPrimePage = pageOwnsReleaseNotice && moduleId === "prime-factorizer";
const renderers = interactiveComponentImports[record.componentId as keyof typeof interactiveComponentImports];
if (!renderers) throw new Error(`Interactive component import is not registered: ${record.componentId}`);
const Renderer = renderers[record.hydration];
if (!Renderer) throw new Error(`Interactive hydration renderer is not registered: ${record.componentId}:${record.hydration}`);
---
<section id={isPrimePage ? "tool-demo" : undefined} tabindex={isPrimePage ? -1 : undefined} data-interactive-module={moduleId} data-bt-font-text={release ? toolReleaseFontText : undefined} aria-label={title}>
  {/* Keep the primary Tool's existing label in the heading outline without repeating a visible page title. */}
  {title && (record.role === "primary_tool"
    ? <h2 class="visually-hidden" data-font-family="body">{title}</h2>
    : <h2>{title}</h2>)}
  {description && <p>{description}</p>}
  {record.hydration === "media" ? <Renderer mediaQuery={record.mediaQuery!} /> : <Renderer />}
  {release && !pageOwnsReleaseNotice && <ToolReleaseNotice release={release} />}
</section>
<style>
  h2.visually-hidden { font-family: var(--font-body); }
  section[data-interactive-module] {
    min-inline-size: 0;
    max-inline-size: 100%;
    --bt-text: var(--text-primary);
    --bt-muted: var(--text-muted);
    --bt-surface: var(--surface-control);
    /* Legacy releases keep their single border; new releases opt into roles. */
    --bt-border: var(--border-tool);
    --bt-border-control: var(--border-control);
    --bt-border-divider: var(--border-divider);
    --bt-accent: var(--accent);
    --bt-on-accent: var(--on-accent);
    --bt-danger: var(--text-danger);
    --bt-focus: var(--focus);
    --bt-font-size: 1rem;
    --bt-line-height: var(--disclosure-line-height);
    --bt-summary-font-size: var(--disclosure-font-size);
    --bt-summary-font-weight: var(--disclosure-font-weight);
    --bt-summary-padding-block: var(--disclosure-padding-block);
    --bt-help-font-size: .9rem;
    --bt-heading-font-size: 1.2rem;
    --bt-control-min-size: var(--control-min-size);
    --bt-font-family: var(--font-body);
  }
</style>
