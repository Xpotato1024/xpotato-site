---
import MediaPicture from "./MediaPicture.astro";
interface Props {
  asset: string;
  alt: string;
  caption?: string;
  credit?: string;
  sourceUrl?: string;
  width?: "content" | "wide" | "full" | "compact";
}
const { asset, alt, caption, credit, sourceUrl, width = "content" } = Astro.props;
---
<figure class:list={{"article-compact-figure":width==="compact"}} data-media-asset={asset} data-width={width}>
  <MediaPicture asset={asset} alt={alt} />
  {(caption || credit || sourceUrl) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {credit && <span> {credit}</span>}
      {sourceUrl && <a href={sourceUrl}> 出典</a>}
    </figcaption>
  )}
</figure>
