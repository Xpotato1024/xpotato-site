---
import type { GeneratedArchivePage } from "../../lib/discovery/discovery.js";
import { archiveRoute, generateArchivePages } from "../../lib/discovery/discovery.js";
import { getLiveContentCatalog } from "../../lib/discovery/live-catalog.js";
import { selectWebIndexableCatalog } from "../../lib/discovery/catalog.js";
import { taxonomyRegistry } from "../../content-registry/taxonomy/index.js";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLineage } from "../../lib/articles/blog-taxonomy.js";
import ToolBreadcrumbs from './ToolBreadcrumbs.astro';
import { siteConfig } from '../../lib/site-config.js';
import BlogArchiveNavigation from './BlogArchiveNavigation.astro';
import ArticleCard from './ArticleCard.astro';
interface Props { page: GeneratedArchivePage; }
const { page } = Astro.props;
const baseRoute = page.route.replace(/\/page\/\d+\/$/u, "/");
const previousRoute = page.page > 1 ? archiveRoute(baseRoute, page.page - 1) : undefined;
const nextRoute = page.page < page.totalPages ? archiveRoute(baseRoute, page.page + 1) : undefined;
const catalog = selectWebIndexableCatalog(await getLiveContentCatalog());
const allScopes = generateArchivePages(catalog.map(e => e.discoveryRecord), taxonomyRegistry).filter(p => p.collection === page.collection && p.page === 1);
const scopeLabel = (scope: GeneratedArchivePage) => scope.scope.kind === 'category'
  ? categoryLineage(scope.scope.id,taxonomyRegistry).map(term=>term.label).join(' / ')
  : scope.title.replace(/^(記事|メモ): /u, '');
const origin = siteConfig.site.canonicalOrigin;
const categoryParents = page.scope.kind==='category' ? categoryLineage(page.scope.id,taxonomyRegistry).slice(0,-1) : [];
const breadcrumbs = page.collection==='blog' && page.scope.kind!=='root' ? [
  {name:'記事',url:new URL('/articles/',origin).href},
  ...categoryParents.map(term=>({name:term.label,url:new URL(`/articles/category/${term.slug}/`,origin).href})),
  {name:scopeLabel(page),url:new URL(page.route,origin).href},
] : [];
---
<BaseLayout title={page.title} description={page.description} noindex={page.noindex} breadcrumbs={breadcrumbs}>
  <main id="main-content" class="archive">
    {breadcrumbs.length>0 && <ToolBreadcrumbs items={breadcrumbs} />}
    <div class="page-heading"><p class="eyebrow">Writing / {page.collection === "blog" ? "記事" : "メモ"}</p><h1>{page.title}</h1><p>{page.description}</p></div>
    <BlogArchiveNavigation pages={allScopes} taxonomy={taxonomyRegistry} collection={page.collection} currentRoute={baseRoute} root={page.scope.kind==='root'} />
    {page.items.length === 0 ? <div class="empty-state"><h2>{page.collection === "notes" ? "まだメモはありません。" : "まだ公開された記事はありません。"}</h2><p>{page.collection === "notes" ? "書きとめたことが、日付順に並びます。" : "公開された記事は、ここに並びます。"}</p><a href="/projects/">制作物を見る <span aria-hidden="true">→</span></a></div> : page.collection === "blog" ? <ul class="article-list article-card-list">{page.items.map(item => <li><ArticleCard item={item} /></li>)}</ul> : <ul class="article-list">{page.items.map(item => <li><article><div class="article-meta">{item.pubDate && <time datetime={item.pubDate}>{item.pubDate}</time>}</div><div><h2><a href={item.route}>{item.title}<span aria-hidden="true"> →</span></a></h2><p>{item.description}</p></div></article></li>)}</ul>}
    <nav class="pagination" aria-label="ページ移動">{previousRoute && <a rel="prev" href={previousRoute}>← 前のページ</a>}<span>{page.page} / {page.totalPages}</span>{nextRoute && <a rel="next" href={nextRoute}>次のページ →</a>}</nav>
  </main>
</BaseLayout>
<style>
  .article-card-list { list-style: none; padding: 0; }
  .article-card-list > li { border-bottom: 1px solid var(--border); padding-block: 1.75rem; }
</style>
