---
/** Small, decorative SVG vocabulary for semantic article structures. */
type Name = "contents" | "note" | "tip" | "warning" | "important" | "symptom" | "inspect" | "reason";
interface Props { name: Name }
const { name } = Astro.props;
const shapes: Record<Name, readonly string[]> = {
  contents: ["M8 6h13", "M8 12h13", "M8 18h13", "M3 6h.01", "M3 12h.01", "M3 18h.01"],
  note: ["M5 3h10l4 4v14H5z", "M15 3v5h4", "M8 12h8", "M8 16h8"],
  tip: ["M9 18h6", "M10 21h4", "M12 3a7 7 0 0 1 4 12.75c-.72.52-1 1.25-1 2.25H9c0-1-.28-1.73-1-2.25A7 7 0 0 1 12 3z"],
  warning: ["M12 3 2 21h20L12 3z", "M12 9v5", "M12 17h.01"],
  important: ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z", "M12 7v6", "M12 17h.01"],
  symptom: ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z", "M12 7v6", "M12 17h.01"],
  inspect: ["M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z", "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"],
  reason: ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z", "M12 11v6", "M12 7h.01"],
};
---
<svg class="article-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {shapes[name].map((d) => <path d={d} />)}
</svg>
