---
interface Props { href: string; title: string; description?: string; label?: string; external?: boolean }
const { href, title, description, label, external = false } = Astro.props;
---
<a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
  {label && <span>{label}</span>}
  <strong>{title}</strong>
  {description && <span>{description}</span>}
</a>
