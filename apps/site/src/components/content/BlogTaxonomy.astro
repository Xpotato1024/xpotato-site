---
interface Props { category: { label: string; href?: string | undefined }; tags: readonly { id: string; label: string; kind:'technology'|'topic'|'purpose'; href?: string | undefined }[] }
const { category, tags } = Astro.props;
const labels = { technology: '技術タグ', topic: '関連テーマ', purpose: '記事の目的' };
---
<div class="blog-taxonomy" data-search-exclude="true">
  <span class="primary-category"><span class="visually-hidden">主分類: </span>{category.href ? <a href={category.href}>{category.label}</a> : <span>{category.label}</span>}</span>
  {tags.length > 0 && <><span class="taxonomy-separator" aria-hidden="true">›</span><ul aria-label="記事のタグ">{tags.map(tag => <li><span class="visually-hidden">{labels[tag.kind]}: </span>{tag.href ? <a href={tag.href} rel="tag">{tag.label}</a> : <span>{tag.label}</span>}</li>)}</ul></>}
</div>
<style>
  .blog-taxonomy { display: flex; align-items: baseline; gap: .5rem; margin-block: .5rem 0; font: .85rem/1.8 var(--font-meta); }
  .primary-category { flex: 0 0 auto; max-inline-size: 45%; color: var(--accent); overflow-wrap: anywhere; }
  .taxonomy-separator { flex: none; color: var(--text-muted); }
  ul { display: flex; flex-wrap: wrap; flex: 1; min-inline-size: 0; list-style: none; gap: .15rem .9rem; margin: 0; padding: 0; }
  li { min-inline-size: 0; max-inline-size: 100%; overflow-wrap: anywhere; }
  a { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
  @media print { .blog-taxonomy { font-size: 9pt; } }
</style>
