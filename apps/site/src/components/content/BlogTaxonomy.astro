---
interface Props { category: { label: string; href?: string | undefined }; tags: readonly { id: string; label: string; href?: string | undefined }[] }
const { category, tags } = Astro.props;
---
<div class="blog-taxonomy" data-search-exclude="true">
  <p class="primary-category"><span class="taxonomy-label">主分類</span>{category.href ? <a href={category.href}>{category.label}</a> : <span>{category.label}</span>}</p>
  {tags.length > 0 && <div class="related-tags"><span class="taxonomy-label">関連タグ</span><ul aria-label="関連タグ">{tags.map(tag => <li>{tag.href ? <a href={tag.href} rel="tag">{tag.label}</a> : <span>{tag.label}</span>}</li>)}</ul></div>}
</div>
<style>
  .blog-taxonomy { display: grid; gap: .6rem; margin-block: 1rem; font-family: var(--font-body); font-size: .9rem; }
  .primary-category,.related-tags { display:flex; flex-wrap:wrap; align-items:baseline; gap:.5rem 1rem; }
  .taxonomy-label { color:var(--text-muted); font-size:.8rem; }
  ul { display:flex; flex-wrap:wrap; list-style:none; gap:.5rem; margin:0; padding:0; }
  li a,li>span { display:inline-block; border:1px solid var(--border); border-radius:.3rem; padding:.2rem .65rem; overflow-wrap:anywhere; }
  a { color:var(--accent); text-decoration:underline; }
  @media print { .blog-taxonomy { font-size:9pt; } }
</style>
