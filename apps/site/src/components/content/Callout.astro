---
import ArticleIcon from "./ArticleIcon.astro";
interface Props { kind: "note" | "tip" | "warning" | "important"; title?: string }
const { kind, title } = Astro.props;
const labels = { note: "補足", tip: "ポイント", warning: "注意", important: "重要" };
---
<aside class="article-callout" data-kind={kind}>
  <span class="article-callout-icon"><ArticleIcon name={kind} /></span>
  <div class="article-callout-content"><strong>{title ?? labels[kind]}</strong><slot /></div>
</aside>
