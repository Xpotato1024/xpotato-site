---
interface Props { title: string; result?: string; children?: unknown }
const { title, result } = Astro.props;
---
<li class="article-step">
  <strong class="article-step-title">{title}</strong>
  <div class="article-step-body"><slot /></div>
  {result && <p class="article-step-result" data-step-result>{result}</p>}
</li>
