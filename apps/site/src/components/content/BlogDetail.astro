---
import { render, type CollectionEntry } from "astro:content";
import type { ContentDiscoveryRecord } from "@xpotato/content-contracts";
import { contentComponents } from "./index.js";
import HistoricalReferenceLink from "./HistoricalReferenceLink.astro";
import RelatedContent from "./RelatedContent.astro";
import { selectTableOfContents } from "../../lib/table-of-contents.js";
import ContentLayout from "../../layouts/ContentLayout.astro";

interface Props {
  entry: CollectionEntry<"blog">;
  related?: readonly ContentDiscoveryRecord[];
  preview?: boolean;
}

const { entry, related = [], preview = false } = Astro.props;
const { Content, headings } = await render(entry);
const blogContentComponents = { ...contentComponents, a: HistoricalReferenceLink };
const seo = preview ? { ...entry.data.seo, noindex: true } : entry.data.seo;
---

<ContentLayout
  id={entry.data.id}
  collection="blog"
  title={entry.data.title}
  description={entry.data.description}
  taxonomy={[entry.data.category, ...entry.data.tags].join(" ")}
  headings={selectTableOfContents(headings, entry.body ?? "")}
  seo={seo}
  publication={{pubDate:entry.data.pubDate,updatedDate:entry.data.updatedDate,draft:entry.data.draft,preview}}
>
  <div slot="metadata" class="article-meta"><time datetime={entry.data.pubDate}>{entry.data.pubDate}</time>{entry.data.updatedDate && <span>更新 <time datetime={entry.data.updatedDate}>{entry.data.updatedDate}</time></span>}{preview && <strong>プレビュー・公開記事ではありません</strong>}</div>
  <Content components={blogContentComponents} />
  <RelatedContent slot="after" items={preview ? [] : related} />
</ContentLayout>
