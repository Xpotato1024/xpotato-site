---
import type { HTMLAttributes } from "astro/types";
import {currentArticleHref} from '../../lib/article-url-history.js';
import {siteConfig} from '../../lib/site-config.js';

type Props = HTMLAttributes<"a">;

const { href, ...attributes } = Astro.props;
const isLocalDriveReference = typeof href === "string" && /^[a-z]:[\\/]/iu.test(href);
---

{isLocalDriveReference ? (
  <span data-historical-local-reference={href}>
    <slot />（当時のローカル資料: <code>{href}</code>）
  </span>
) : (
  <a {...attributes} href={typeof href==='string'?currentArticleHref(href,siteConfig.site.canonicalOrigin):href}>
    <slot />
  </a>
)}
