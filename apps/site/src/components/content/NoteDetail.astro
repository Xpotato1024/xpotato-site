---
import { render, type CollectionEntry } from "astro:content";
import type { ContentDiscoveryRecord } from "@xpotato/content-contracts";
import { contentComponents } from "./index.js";
import RelatedContent from "./RelatedContent.astro";
import { selectTableOfContents } from "../../lib/table-of-contents.js";
import ContentLayout from "../../layouts/ContentLayout.astro";

interface Props {
  entry: CollectionEntry<"notes">;
  related: readonly ContentDiscoveryRecord[];
}

const { entry, related } = Astro.props;
const { Content, headings } = await render(entry);
---

<ContentLayout
  id={entry.data.id}
  collection="notes"
  title={entry.data.title}
  description={entry.data.description}
  taxonomy={[entry.data.subject, ...entry.data.tags].join(" ")}
  headings={selectTableOfContents(headings, entry.body ?? "")}
  seo={entry.data.seo}
  publication={{pubDate:entry.data.pubDate,updatedDate:entry.data.updatedDate,draft:entry.data.draft}}
>
  <div slot="metadata" class="article-meta"><time datetime={entry.data.pubDate}>{entry.data.pubDate}</time>{entry.data.updatedDate && <span>更新 <time datetime={entry.data.updatedDate}>{entry.data.updatedDate}</time></span>}</div>
  <Content components={contentComponents} />
  <RelatedContent slot="after" items={related} />
</ContentLayout>
