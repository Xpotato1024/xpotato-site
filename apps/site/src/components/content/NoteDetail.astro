---
import { render, type CollectionEntry } from "astro:content";
import type { ContentDiscoveryRecord } from "@xpotato/content-contracts";
import { contentComponents } from "./index.js";
import RelatedContent from "./RelatedContent.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";

interface Props {
  entry: CollectionEntry<"notes">;
  related: readonly ContentDiscoveryRecord[];
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  id={entry.data.id}
  collection="notes"
  title={entry.data.title}
  description={entry.data.description}
  taxonomy={[entry.data.subject, ...entry.data.tags].join(" ")}
  seo={entry.data.seo}
>
  <Content components={contentComponents} />
  <RelatedContent slot="after" items={related} />
</ContentLayout>
