---
import {primeSiteSourceOffer} from "../../lib/prime-source-offer.mjs";
import type { BrowserToolReleaseDisplay } from "@xpotato/site-validators/browser-tool-display";
interface Props { release: BrowserToolReleaseDisplay; }
const { release } = Astro.props;
const siteOffer=release.scope==="pinned-release"&&release.toolId==="prime-factorizer"?primeSiteSourceOffer():null;
---
<aside class="tool-release" data-tool-release={release.releaseId} aria-label="ツールの採用版と処理について">
  {release.scope === "synthetic-fixture" && <p><strong>合成試験fixture。実ツールの採用・公開実績ではありません。</strong></p>}
  <p>採用版 <span data-tool-version>{release.version}</span>・{release.license}。{release.sourceUrl && <a href={release.sourceUrl} rel="noopener noreferrer">対応ソース</a>}</p>
  <details>
    <summary>ライセンス・配布情報・処理上限</summary>
    <ul class="tool-release-groups">
      {release.toolId === "prime-factorizer" && <li><strong>計算の注意</strong><p data-prime-input-disclaimer>入力の最大桁数は、分解完了を保証する桁数ではありません。</p></li>}
      <li><strong>配布物の入出力上限</strong><p>入力上限 {release.maxInputBytes.toLocaleString("ja-JP")} bytes、出力上限 {release.maxOutputBytes.toLocaleString("ja-JP")} bytes。{release.toolId === "prime-factorizer" && "入力欄の文字数・数値の桁数とは別の、配布物のbyte上限です。"}</p></li>
      <li><strong>ライセンスと対応ソース</strong>
        {!release.sourceUrl && <p>ローカル合成ソース（外部リンクなし）</p>}
        {release.sourceUrl && <p><a href={release.sourceUrl.replace("/tree/","/blob/")+"/LICENSE"} rel="noopener noreferrer">ライセンス全文</a>・<a href={release.sourceUrl.replace("/tree/","/blob/")+"/SOURCE_OFFER.md"} rel="noopener noreferrer">対応ソースと再ビルド手順</a></p>}
      </li>
      {siteOffer && <li><strong>サイト組み込み版</strong><p data-site-source-commit={siteOffer.revision}><a href={siteOffer.sourceUrl}>サイト組み込みソース</a>・<a href={siteOffer.offerUrl}>対応ソースの提供条件</a>・<a href={siteOffer.archiveUrl}>全ソースarchive</a>・<a href={"/tool-licenses/prime-factorizer-v"+release.version+"/MUSL-COPYRIGHT.txt"}>muslライセンス</a></p></li>}
      <li><strong>ソースの固定情報</strong><p>採用したソースのcommit: <code>{release.sourceCommit}</code></p></li>
    </ul>
  </details>
</aside>
<style>
  .tool-release { margin-block: 1.5rem 0; padding-block: .75rem 0; border: 0; border-top: 1px solid var(--border, #d8d4dc); border-radius: 0; font-size: .9rem; overflow-wrap: anywhere; }
  .tool-release p { margin-block: .5rem; }
  .tool-release summary { min-height: max(2.75rem,44px); display: list-item; padding-block: .5rem; cursor: pointer; }
  .tool-release details { margin-block: .5rem; }
  .tool-release summary:focus-visible { outline: 3px solid var(--focus, #5b4177); outline-offset: 3px; }
  .tool-release code { overflow-wrap: anywhere; }
  .tool-release .tool-release-groups { margin-block: .5rem; padding-inline-start: 1.25rem; list-style: disc; }
  .tool-release .tool-release-groups > li { margin-block: .75rem; }
  .tool-release .tool-release-groups p { margin-block: .3rem; }
</style>
