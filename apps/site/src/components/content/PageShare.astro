---
interface Props { share: NonNullable<ReturnType<typeof import('../../lib/page-share.js').derivePageShare>> }
const { share } = Astro.props;
---
<section class="page-share" aria-label="ページの共有" data-page-share data-share-title={share.title} data-share-url={share.url} data-search-exclude="true">
  <h2>ページを共有</h2>
  <div class="page-share-actions">
    <a href={share.x} target="_blank" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer" aria-label="Xで公開ページを共有（新しいタブ）">X</a>
    <a href={share.line} target="_blank" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer" aria-label="LINEで公開ページを共有（新しいタブ）">LINE</a>
    <button type="button" data-share-native hidden>端末で共有</button>
    <button type="button" data-share-copy hidden>リンクをコピー</button>
  </div>
  <p class="page-share-note">ページ名と公開 URL のみを共有します。</p>
  <p class="page-share-status" role="status" aria-live="polite" aria-atomic="true"></p>
  <details class="page-share-manual">
    <summary>公開 URL を表示</summary>
    <label>選択してコピーできる公開 URL<input type="text" value={share.url} readonly aria-label="公開 URL" inputmode="url" /></label>
  </details>
</section>
<script is:inline type="module" src="/scripts/page-share.js"></script>
