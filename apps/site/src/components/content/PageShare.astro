---
interface Props { share: NonNullable<ReturnType<typeof import('../../lib/page-share.js').derivePageShare>> }
const { share } = Astro.props;
---
<section class="page-share" aria-label="ページの共有" data-page-share data-share-title={share.title} data-share-url={share.url} data-search-exclude="true">
  <h2 data-font-family="body">ページを共有</h2>
  <div class="page-share-actions">
    <a href={share.x} target="_blank" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer" aria-label="Xで公開ページを共有（新しいタブ）">X</a>
    <a href={share.line} target="_blank" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer" aria-label="LINEで公開ページを共有（新しいタブ）">LINE</a>
    <button type="button" data-share-native hidden>端末で共有</button>
    <button type="button" data-share-copy hidden>リンクをコピー</button>
  </div>
  <p class="page-share-note">ページ名と公開 URL のみを共有します。</p>
  <p class="page-share-status" role="status" aria-live="polite" aria-atomic="true"></p>
  <details class="page-share-manual">
    <summary>公開 URL を表示</summary>
    <label>選択してコピーできる公開 URL<input type="text" value={share.url} readonly aria-label="公開 URL" inputmode="url" /></label>
  </details>
</section>
<script is:inline type="module" src="/scripts/page-share.js"></script>
<style>
 .page-share { border-block-start: 1px solid var(--border); margin-block: 2rem 1rem; padding-block-start: 1rem; min-inline-size: 0; }
 h2 { font: 600 1rem/1.6 var(--font-body); margin: 0 0 .5rem; }
 .page-share-actions { display: flex; flex-flow: row wrap; gap: .5rem; }
 .page-share-actions a, .page-share-actions button { display: inline-flex; justify-content: center; align-items: center; box-sizing: border-box; min-block-size: 44px; min-inline-size: 44px; padding: .5rem .75rem; border: 1px solid var(--text-muted); border-radius: .2rem; background: var(--surface); color: var(--text-primary); font: inherit; font-size: 1rem; line-height: 1.5; text-decoration: none; cursor: pointer; overflow-wrap: anywhere; max-inline-size: 100%; }
 .page-share-actions [hidden] { display: none; }
 .page-share-actions a:hover, .page-share-actions button:hover { background: var(--border); }
 .page-share-actions a:active, .page-share-actions button:active { border-color: var(--accent); }
 .page-share-note, .page-share-status, .page-share-manual { font-size: .85rem; line-height: 1.6; margin-block: .5rem 0; overflow-wrap: anywhere; }
 .page-share-note { color: var(--text-muted); }
 .page-share-status:empty { margin: 0; }
 .page-share-manual summary { cursor: pointer; min-block-size: 44px; padding-block: .5rem; box-sizing: border-box; }
 .page-share-manual input { display: block; width: 100%; min-inline-size: 0; max-inline-size: 100%; box-sizing: border-box; min-block-size: 44px; padding: .5rem; margin-top: .25rem; background: var(--surface); color: var(--text-primary); border: 1px solid var(--text-muted); font: inherit; font-size: 1rem; }
</style>
