---
import { comparisonModulePropsSchema } from "@xpotato/content-contracts/content";
const { leftLabel, rightLabel } = comparisonModulePropsSchema.parse(Astro.props);
const legacy = Boolean(leftLabel && rightLabel);
---

<section
  class="article-comparison"
  aria-label="条件比較"
  data-left-label={leftLabel}
  data-right-label={rightLabel}
>
  {legacy && (
    <header class="article-comparison__legacy-labels">
      <span>{leftLabel}</span>
      <span>{rightLabel}</span>
    </header>
  )}
  <div class={legacy ? "article-comparison__legacy-body" : "article-comparison__cases"}>
    <slot />
  </div>
</section>
