---
import { renderLineChart } from "@xpotato/portable-content/charts";
interface Props {
  title: string;
  description?: string;
  xLabel: string;
  yLabel: string;
  kind?: "line" | "scatter" | "analysis";
  series: string;
  xMin?: string;
  xMax?: string;
  yMin?: string;
  yMax?: string;
  xPadding?: string;
  yPadding?: string;
}
const markup = renderLineChart(Astro.props);
---

<Fragment set:html={markup} />
