---
import "../styles/global.css";
import SiteHeader from "../shell/SiteHeader.astro";
import SiteFooter from "../shell/SiteFooter.astro";
import { siteConfig } from "../lib/site-config.js";
import { serializeJsonLd, deriveBreadcrumbList, type ContentBreadcrumb, type PublishedSeoImage } from "../../features/discovery/model/seo.js";

interface Props {
  homeHeader?: boolean;
  primePwa?: boolean;
  articleCssHref?: string | undefined;
  pageCssHrefs?: readonly string[];
  articleModulesCssHref?: string | undefined;
  privateCandidate?: boolean;
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  articleMetadata?: ReturnType<typeof import("../../features/discovery/model/seo.js").deriveArticleSeo> | undefined;
  image?: PublishedSeoImage | undefined;
  breadcrumbs?: readonly ContentBreadcrumb[];
}

const { title, description = siteConfig.site.defaultDescription, noindex = false, canonical: canonicalOverride, articleMetadata, image, privateCandidate=false, breadcrumbs=[], articleCssHref, articleModulesCssHref } = Astro.props;
const breadcrumbMetadata = deriveBreadcrumbList(breadcrumbs);
const canonical = new URL(canonicalOverride ?? Astro.url.pathname, siteConfig.site.canonicalOrigin);
---

<!doctype html>
<html lang={siteConfig.site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {articleCssHref && <link rel="stylesheet" href={articleCssHref} />}
    {articleModulesCssHref && <link rel="stylesheet" href={articleModulesCssHref} />}
    {Astro.props.pageCssHrefs?.map(href => <link rel="stylesheet" href={href} />)}
    <title>{title} | {siteConfig.site.shortName}</title>
    <meta name="description" content={description} />
    {privateCandidate && <meta name="xpotato-private-draft-preview-v1" content="candidate;productionEligible=false" />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" type="image/png" href="/icon-apple-touch.png" sizes="180x180" />
    {Astro.props.primePwa && <><link rel="manifest" href="/tools/prime-factorizer/manifest.webmanifest" /><meta name="application-name" content="素因数分解機" /><meta name="apple-mobile-web-app-title" content="素因数分解機" /><meta name="theme-color" content="#ffffff" /></>}
    <meta property="og:site_name" content={siteConfig.site.name} />
    <meta property="og:type" content={articleMetadata ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content={image && !noindex ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && !noindex && <><meta name="twitter:image" content={image.url} />{image.alt && <meta name="twitter:image:alt" content={image.alt} />}</>}
    {articleMetadata && <><meta property="article:published_time" content={articleMetadata.datePublished} />{articleMetadata.dateModified && <meta property="article:modified_time" content={articleMetadata.dateModified} />}</>}
    {image && (!noindex||privateCandidate) && <><meta property="og:image" content={image.url} /><meta property="og:image:width" content={String(image.width)} /><meta property="og:image:height" content={String(image.height)} />{image.alt && <meta property="og:image:alt" content={image.alt} />}</>}
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.site.name} RSS`} href="/rss.xml" />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd({ "@context": "https://schema.org", "@type": "WebPage", name: title, description, url: canonical.href, inLanguage: siteConfig.site.locale })}></script>
    {articleMetadata && <script is:inline type="application/ld+json" set:html={serializeJsonLd(articleMetadata)}></script>}
    {breadcrumbMetadata && <script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbMetadata)}></script>}
  </head>
  <body class:list={{ 'home-header-layout': Astro.props.homeHeader }}>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SiteHeader homeHeader={Astro.props.homeHeader === true} />
    <slot />
    <SiteFooter />
  </body>
</html>
