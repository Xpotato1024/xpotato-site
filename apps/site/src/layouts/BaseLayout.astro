---
import "../styles/global.css";
import { siteConfig } from "../lib/site-config.js";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
}

const { title, description = siteConfig.site.defaultDescription, noindex = false, canonical: canonicalOverride } = Astro.props;
const canonical = new URL(canonicalOverride ?? Astro.url.pathname, siteConfig.site.canonicalOrigin);
const navigation = siteConfig.navigation.filter((item) => item.status === "active" && item.location.includes("header")).sort((a, b) => a.order - b.order);
const footerNavigation = siteConfig.navigation.filter((item) => item.status === "active" && item.location.includes("footer")).sort((a, b) => a.order - b.order);
const menuNavigation = [...navigation.filter((item) => item.id !== "search"), ...footerNavigation.filter((item) => item.id === "notes")];
---

<!doctype html>
<html lang={siteConfig.site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | {siteConfig.site.shortName}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.site.name} RSS`} href="/rss.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "WebPage", name: title, description, url: canonical.href, inLanguage: siteConfig.site.locale })}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <div class="header-band"><header class="site-header">
      <a class="brand" href="/" aria-label={`${siteConfig.site.name}.net ホーム`}><img src="/xpotato-logo.svg" width="48" height="33" alt="" /><span>{siteConfig.site.name}<span class="brand-domain">.net</span><small>Think. Build. Run.</small></span></a>
      <nav class="desktop-navigation" aria-label="主要ナビゲーション">
        <ul>{navigation.map((item) => <li><a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>)}</ul>
      </nav>
      <div class="mobile-navigation">
        <a class="mobile-search" href={siteConfig.discovery.searchPath} aria-current={Astro.url.pathname === siteConfig.discovery.searchPath ? "page" : undefined}>検索</a>
        <details class="mobile-menu"><summary>メニュー</summary><nav aria-label="モバイルナビゲーション"><ul>{menuNavigation.map((item) => <li><a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>)}</ul></nav></details>
      </div>
    </header></div>
    <slot />
    <footer class="site-footer"><small>© {siteConfig.site.name}</small><nav aria-label="補助ナビゲーション">{footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}<a href={siteConfig.discovery.rssPath}>RSS</a></nav></footer>
  </body>
</html>
