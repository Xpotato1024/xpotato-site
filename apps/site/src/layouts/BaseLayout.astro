---
import "../styles/global.css";
import { siteConfig } from "../lib/site-config.js";
import { serializeJsonLd, type PublishedSeoImage } from "../lib/seo.js";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  articleMetadata?: ReturnType<typeof import("../lib/seo.js").deriveArticleSeo> | undefined;
  image?: PublishedSeoImage | undefined;
}

const { title, description = siteConfig.site.defaultDescription, noindex = false, canonical: canonicalOverride, articleMetadata, image } = Astro.props;
const canonical = new URL(canonicalOverride ?? Astro.url.pathname, siteConfig.site.canonicalOrigin);
const navigation = siteConfig.navigation.filter((item) => item.status === "active" && item.location.includes("header")).sort((a, b) => a.order - b.order);
const desktopNavigation = navigation.filter((item) => item.id !== "search");
const footerNavigation = siteConfig.navigation.filter((item) => item.status === "active" && item.location.includes("footer")).sort((a, b) => a.order - b.order);
const menuNavigation = [...navigation.filter((item) => item.id !== "search"), ...footerNavigation.filter((item) => item.id === "notes")];
---

<!doctype html>
<html lang={siteConfig.site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | {siteConfig.site.shortName}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={articleMetadata ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {articleMetadata && <><meta property="article:published_time" content={articleMetadata.datePublished} />{articleMetadata.dateModified && <meta property="article:modified_time" content={articleMetadata.dateModified} />}</>}
    {image && !noindex && <><meta property="og:image" content={image.url} /><meta property="og:image:width" content={String(image.width)} /><meta property="og:image:height" content={String(image.height)} />{image.alt && <meta property="og:image:alt" content={image.alt} />}</>}
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.site.name} RSS`} href="/rss.xml" />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd({ "@context": "https://schema.org", "@type": "WebPage", name: title, description, url: canonical.href, inLanguage: siteConfig.site.locale })}></script>
    {articleMetadata && <script is:inline type="application/ld+json" set:html={serializeJsonLd(articleMetadata)}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <div class="header-band"><header class="site-header">
      <a class="brand" href="/" aria-label={`${siteConfig.site.name}.net ホーム`}><img src="/xpotato-logo.svg" width="48" height="33" alt="" /><span>{siteConfig.site.name}<span class="brand-domain">.net</span><small>Think. Build. Run.</small></span></a>
      <nav class="desktop-navigation" aria-label="主要ナビゲーション">
        <ul>{desktopNavigation.map((item) => <li><a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>)}</ul>
      </nav>
      <form class="header-search" role="search" aria-label="ヘッダーのサイト内検索" action={siteConfig.discovery.searchPath} method="get">
        <label class="visually-hidden" for="header-search-query">サイト内検索</label>
        <input id="header-search-query" name="q" type="search" placeholder="サイト内検索" autocomplete="off" />
        <button type="submit" aria-label="検索する"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg></button>
      </form>
      <div class="mobile-navigation">
        <a class="mobile-search" href={siteConfig.discovery.searchPath} aria-label="検索ページを開く" aria-current={Astro.url.pathname === siteConfig.discovery.searchPath ? "page" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg></a>
        <button class="mobile-menu-toggle" type="button" popovertarget="site-menu" aria-controls="site-menu" aria-label="メニュー"><span class="menu-icon" aria-hidden="true"><span></span><span></span></span></button>
        <nav id="site-menu" class="mobile-menu-panel" popover="auto" aria-label="モバイルナビゲーション"><ul>{menuNavigation.map((item) => <li><a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>)}</ul></nav>
        <details class="mobile-menu mobile-menu-fallback"><summary aria-label="メニュー"><span class="menu-icon" aria-hidden="true"><span></span><span></span></span></summary><nav aria-label="モバイルナビゲーション"><ul>{menuNavigation.map((item) => <li><a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>)}</ul></nav></details>
      </div>
    </header></div>
    <slot />
    <footer class="site-footer"><small>© {siteConfig.site.name}</small><nav aria-label="補助ナビゲーション">{footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}<a href={siteConfig.discovery.rssPath}>RSS</a></nav></footer>
  </body>
</html>
