---
import type { SeoOverride } from "@xpotato/content-contracts";
import { siteConfig } from "../lib/site-config.js";
import { deriveContentSeo } from "../lib/seo.js";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  id: string;
  collection: string;
  title: string;
  description: string;
  taxonomy?: string | undefined;
  seo?: SeoOverride | undefined;
}
const { id, collection, title, description, taxonomy = "", seo } = Astro.props;
const metadata = deriveContentSeo({
  title,
  description,
  route: Astro.url.pathname,
  canonicalOrigin: siteConfig.site.canonicalOrigin,
  seo,
});
---

<BaseLayout title={metadata.title} description={metadata.description} noindex={metadata.noindex} canonical={metadata.canonical}>
  <main
    id="main-content"
    class="content-page"
    data-search-body
    data-search-id={id}
    data-search-collection={collection}
    data-search-title={title}
    data-search-description={description}
    data-search-taxonomy={taxonomy}
  >
    <article>
      <div class="content-heading"><a class="eyebrow" href={collection === "pages" ? "/pages/" : `/${collection}/`}>{collection === "blog" ? "Blog" : collection === "notes" ? "Notes" : collection === "projects" ? "Projects" : collection === "tools" ? "Tools" : "Pages"} <span aria-hidden="true"> /</span></a><h1>{title}</h1><p class="content-description">{description}</p><slot name="metadata" /></div>
      <div class="prose"><slot /></div>
      <a class="back-link" href={collection === "pages" ? "/pages/" : `/${collection}/`}>← 一覧へ戻る</a>
    </article>
  </main>
  <slot name="after" />
</BaseLayout>
