---
import type { SeoOverride } from "@xpotato/content-contracts";
import { siteConfig } from "../lib/site-config.js";
import { deriveContentSeo, deriveArticleSeo, deriveToolBreadcrumbs } from "../lib/seo.js";
import type { ContentHeading } from "../lib/table-of-contents.js";
import { addSectionLinks } from "../lib/section-links.js";
import {contentMediaContext,candidateBuildOverlay} from "../lib/media-context.js";
import {renderMarkdownMedia} from "../lib/markdown-media.js";
import {renderRegistryPicture} from "@xpotato/portable-content/media-picture";
import BaseLayout from "./BaseLayout.astro";
import "../styles/content.css";
import codeCssHref from "../styles/code.css?url";
import PageShare from "../components/content/PageShare.astro";
import TableOfContents from "../components/content/TableOfContents.astro";
import {splitArticleLead} from "../lib/article-lead.js";
import articleModulesCssHref from "../styles/article-modules.css?url";
import articleCssHref from "../styles/article-structure.css?url";
import ToolBreadcrumbs from "../components/content/ToolBreadcrumbs.astro";
import { derivePageShare } from "../lib/page-share.js";

interface Props {
  id: string;
  collection: string;
  title: string;
  description: string;
  taxonomy?: string | undefined;
  seo?: SeoOverride | undefined;
  headings?: readonly ContentHeading[];
  publication?: { pubDate: string; updatedDate?: string | undefined; draft: boolean; preview?: boolean | undefined };
  breadcrumbs?: readonly import('../lib/seo.js').ContentBreadcrumb[] | undefined;
}
const { id, collection, title, description, taxonomy = "", seo, headings = [], publication } = Astro.props;
Astro.locals.xpotatoContentId=id;
const mediaContext=contentMediaContext(id),privateCandidate=mediaContext?.candidate===true;
const overlay=privateCandidate?candidateBuildOverlay():undefined;
const hero=mediaContext?.registry.assets.find(asset=>asset.role==="hero"&&asset.status==="active");
const bodyHtml = addSectionLinks(renderMarkdownMedia(await Astro.slots.render("default"),mediaContext), headings);
const articleParts = collection === "blog" ? splitArticleLead(bodyHtml) : {lead:"",body:bodyHtml};
const hasCodeBlocks = bodyHtml.includes("data-code-block");
const hasArticleModules = /class="[^"\n]*\barticle-(?:callout|steps|diagnostics|diagrams|compact-figure)\b/u.test(bodyHtml);
const metadata = deriveContentSeo({
  title,
  description,
  route: Astro.url.pathname,
  canonicalOrigin: siteConfig.site.canonicalOrigin,
  seo,
});
const articleMetadata = publication ? deriveArticleSeo({ ...publication, preview:privateCandidate || publication.preview, collection, title, description, canonical:metadata.canonical, noindex:metadata.noindex,image:mediaContext?.image, author:{name:siteConfig.publisher.displayName,url:new URL('/about/',siteConfig.site.canonicalOrigin).href} }) : undefined;
const breadcrumbs = Astro.props.breadcrumbs ?? deriveToolBreadcrumbs({ collection, title, canonical: metadata.canonical, canonicalOrigin: siteConfig.site.canonicalOrigin });
const share = derivePageShare({ collection, title, canonical: metadata.canonical, canonicalOrigin: siteConfig.site.canonicalOrigin,
  published: publication ? !publication.draft : collection === 'tools', noindex: metadata.noindex, preview: privateCandidate || publication?.preview === true });
---

<BaseLayout pageCssHrefs={hasCodeBlocks ? [codeCssHref] : []} articleCssHref={articleCssHref} articleModulesCssHref={hasArticleModules ? articleModulesCssHref : undefined} title={metadata.title} description={metadata.description} noindex={metadata.noindex||privateCandidate} canonical={metadata.canonical} articleMetadata={articleMetadata} image={mediaContext?.image} privateCandidate={privateCandidate} breadcrumbs={privateCandidate ? [] : breadcrumbs}>
  <main
    id="main-content"
    class="content-page"
    data-search-body
    data-search-id={id}
    data-search-collection={collection}
    data-search-title={title}
    data-search-description={description}
    data-search-taxonomy={taxonomy}
  >
    <article>
      <div class="content-heading">{breadcrumbs.length ? <ToolBreadcrumbs items={breadcrumbs} /> : <a class="eyebrow" href={collection === "pages" ? "/" : `/${collection}/`}>{collection === "blog" ? "Articles" : collection === "notes" ? "Notes" : collection === "projects" ? "Projects" : "Xpotato"} <span aria-hidden="true"> /</span></a>}<h1>{title}</h1><p class="content-description">{description}</p><slot name="metadata" /></div>
      {privateCandidate && <aside class="candidate-preview-notice" data-search-exclude="true">{overlay?.scope==="synthetic_fixture"?"検証用のサンプル記事です。未公開・未承認。":overlay?.reference?"参考previewです。正式な候補・本人承認ではありません。":overlay?.planConfirmed?"公開前の候補previewです。承認・公開は行っていません。":"配信・保存計画が未確認の参考previewです。承認できる候補ではありません。"}</aside>}
      {articleParts.lead && <div class="prose article-lead" set:html={articleParts.lead} />}
      {hero&&mediaContext&&<div class="article-hero" set:html={renderRegistryPicture({registry:mediaContext.registry,urlFor:mediaContext.urlFor,assetId:hero.assetId,priority:true})} />}
      <TableOfContents headings={headings} />
      <div class="prose article-body" set:html={articleParts.body} />
      {share && <PageShare share={share} />}
      <a class="back-link" href={collection === "pages" ? "/" : `/${collection}/`}>{collection === "pages" ? "← ホームへ" : "← 一覧へ戻る"}</a>
    </article>
  </main>
  <slot name="after" />
  {hasCodeBlocks && <script is:inline src="/scripts/code-copy.js" defer></script>}
</BaseLayout>
