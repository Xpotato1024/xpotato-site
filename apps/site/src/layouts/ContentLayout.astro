---
import type { SeoOverride } from "@xpotato/content-contracts";
import { siteConfig } from "../lib/site-config.js";
import { deriveContentSeo } from "../lib/seo.js";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  id: string;
  collection: string;
  title: string;
  description: string;
  taxonomy?: string | undefined;
  seo?: SeoOverride | undefined;
}
const { id, collection, title, description, taxonomy = "", seo } = Astro.props;
const metadata = deriveContentSeo({
  title,
  description,
  route: Astro.url.pathname,
  canonicalOrigin: siteConfig.site.canonicalOrigin,
  seo,
});
---

<BaseLayout title={metadata.title} description={metadata.description} noindex={metadata.noindex} canonical={metadata.canonical}>
  <main
    data-search-body
    data-search-id={id}
    data-search-collection={collection}
    data-search-title={title}
    data-search-description={description}
    data-search-taxonomy={taxonomy}
  >
    <article>
      <h1>{title}</h1>
      <slot />
    </article>
  </main>
</BaseLayout>
