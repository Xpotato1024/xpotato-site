  "moduleSchemas": {
    "BarChart": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "max": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "rows": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24000
        }
      },
      "required": [
        "title",
        "unit",
        "max",
        "rows"
      ],
      "additionalProperties": false
    },
    "Figure": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "width": {
          "type": "string",
          "enum": [
            "content",
            "wide",
            "full",
            "compact"
          ]
        }
      },
      "required": [
        "asset",
        "alt"
      ],
      "additionalProperties": false
    },
    "Gallery": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "string",
          "enum": [
            "content",
            "wide"
          ]
        },
        "layout": {
          "type": "string",
          "enum": [
            "images",
            "diagrams"
          ]
        }
      },
      "additionalProperties": false
    },
    "Callout": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "note",
            "tip",
            "warning",
            "important"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "Steps": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Step": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "Comparison": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "leftLabel": {
          "type": "string",
          "minLength": 1
        },
        "rightLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "leftLabel",
        "rightLabel"
      ],
      "additionalProperties": false
    },
    "LinkCard": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "href": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "external": {
          "type": "boolean"
        }
      },
      "required": [
        "href",
        "title"
      ],
      "additionalProperties": false
    },
    "Details": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "open": {
          "type": "boolean"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "Demo": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "module"
      ],
      "additionalProperties": false
    },
    "DiagnosticList": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "DiagnosticItem": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "symptom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "required": [
        "symptom",
        "check"
      ],
      "additionalProperties": false
    },
    "ArticleEndnote": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
        }
      },
      "additionalProperties": false
    }
  },
