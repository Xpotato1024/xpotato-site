    "BarChart": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "max": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "rows": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24000
        }
      },
      "required": [
        "title",
        "unit",
        "max",
        "rows"
      ],
      "additionalProperties": false
    },
